+/* ══ ASTROLOGY'S NIGHT — THE SECOND SURFACE EXCEPTION ══════════════════════
+   THIS ANSWERS A QUESTION THIS FILE LEFT OPEN RATHER THAN REOPENING A CLOSED
+   ONE, WHICH IS THE WHOLE DIFFERENCE.
+
+   The Relief rollout removed a half-converted dark theme and said so: "every
+   background white" and a night ground cannot both be true. It also left one
+   sentence unresolved — whether the tarot page and the letter should KEEP a
+   night surface as a deliberate one-room exception, "a decision to make before
+   this lands, not after". It landed white and the decision was never made.
+   This is that decision, made the way the press exception was made: named
+   here, scoped to one hub, and pinned by a guard.
+
+   Three things say the room was always meant to be dark. The gold-on-near-black
+   artwork it was drawn for is still in the tree (celestial-frame-tall.webp,
+   celestial-frame-wide.webp, tarot-frame.webp) and was kept on the grounds that
+   putting it back "is a CSS change, not a re-commission". The hub config still
+   declares `dark: true`, read by nothing since the rollout. And the near-white
+   guard in relief.spec.ts records the casualty of turning it white: cream text
+   on a surface that had stopped being dark, "the page whose heading says Birth
+   Details".
+
+   WHY THIS IS NOT A DARK MODE. A dark mode is a second copy of every screen,
+   toggled globally, and half-converted is exactly how it looks like a bug. This
+   is one room with its own light — the same thing a planetarium is. Nothing
+   toggles; there is no switch and no [data-theme]; a citizen who never opens
+   Astrology never sees a dark pixel.
+
+   THE RELIEF IS UNCHANGED, THE LIGHT IS INVERTED. Five depths, no sixth, same
+   geometry. On white the highlight was invisible and the shadow did the work;
+   on charcoal the shadow has nothing to darken and the HIGHLIGHT does it — so
+   the rim's bright edge stays on top at a much lower alpha and the drop shadow
+   deepens. Cards are pressed into the surface, never glossy.
+
+   NO NEW TOKEN NAMES. Every name below already exists in :root; removing this
+   block removes the entire treatment.                                       */
+[data-hub="astrology"] {
+  /* ── Grounds. Soft charcoal, never pure black. ── */
+  --ground: #26242a;
+  --paper:  #26242a;
+  --card:   #333039;
+  --wash:   #302d35;
+  --media-bg: #1c1a1f;
+
+  /* ── THE RAIL FOLLOWS THE ROOM. THE ORANGE DOES NOT. ──────────────────────
+     The lamp is the CITY's — the key you are on, orange, in all twenty-five
+     hubs — and it stays orange here. So does --on-accent, and so does the
+     black primary button. Those are the furniture, and re-lettering a signpost
+     per room is how a citizen has to learn the building twice.
+
+     The WELL the rail sits in is not furniture, it is wall, and it has to
+     follow: every label on the rail reads --ink, --ink-soft and --faint, the
+     same tokens the room re-points. Left white, the rail keeps a white
+     background under ivory text and the hub name disappears — the "Birth
+     Details" failure again, one panel to the left. The keys darken with it for
+     the reason the token above gives: white glass has nothing to bend on a
+     dark well and collapses to a pale rectangle.
+
+     White on the orange lamp is 4.7:1 and the lamp is unchanged, so its label
+     and its subtitle both keep working with no override anywhere. */
+  --rail-well: #242228;
+  --rail-well-shadow: inset -1px 0 0 #3a3640;
+  --lens-face: linear-gradient(180deg, #3a3640 0%, #333039 52%, #2c2a32 100%);
+  --lens: inset 0 0 0 1.5px rgba(255,255,255,.07),
+          inset 0 0 0 4px rgba(184,147,85,.10),
+          inset 0 8px 12px -8px rgba(0,0,0,.45),
+          inset 0 -10px 14px -7px rgba(255,255,255,.05),
+          0 1px 1px rgba(0,0,0,.30), 0 6px 16px rgba(0,0,0,.34), 0 18px 40px rgba(0,0,0,.30);
+  --lens-key: inset 0 0 0 1.2px rgba(255,255,255,.06),
+              inset 0 0 0 3px rgba(184,147,85,.08),
+              inset 0 6px 9px -7px rgba(0,0,0,.40),
+              inset 0 -8px 11px -6px rgba(255,255,255,.045),
+              0 1px 1px rgba(0,0,0,.28), 0 3px 8px rgba(0,0,0,.30);
+
+  /* ── Ink. Warm ivory, never pure white. Contrast on the ground above. ── */
+  --ink:      #f3efe7;   /* 12.4:1 */
+  --ink-soft: #e6e1d8;   /* 10.7:1 */
+  --muted:    #b9b2a8;   /*  6.7:1 — descriptions */
+  --faint:    #8e8984;   /*  3.9:1 — labels and metadata ONLY */
+  --line:     #4e4952;
+  --line-2:   #5b555e;
+
+  /* ── Faces. Same construction, lit from above, in charcoal. ── */
+  --face:      linear-gradient(180deg, #39353f 0%, #343039 52%, #2e2b34 100%);
+  --face-2:    linear-gradient(180deg, #3b3742 0%, #35313b 48%, #2f2c35 100%);
+  --face-tall: linear-gradient(180deg, #39353f 0%, #39353f calc(100% - min(96px, 40%)), #2e2b34 100%);
+  --face-key:  linear-gradient(180deg, #3a3640 0%, #343039 52%, #2d2a33 100%);
+  --well:      linear-gradient(180deg, #232128 0%, #292731 58%, #302d37 100%);
+
+  /* ── The rim, inverted: the bright edge is the one doing the work now. ── */
+  --rim:        inset 0 0 0 1px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.055), inset 0 -1px 0 rgba(0,0,0,.30);
+  --rim-strong: inset 0 0 0 1px rgba(0,0,0,.42), inset 0 1.5px 0 rgba(255,255,255,.07), inset 0 -1.5px 0 rgba(0,0,0,.36);
+
+  /* ── The five depths. Same geometry, deeper shadow. ── */
+  --e1: var(--rim),        0 1px 1px rgba(0,0,0,.22), 0 2px 4px rgba(0,0,0,.24), 0 6px 13px rgba(0,0,0,.30);
+  --e2: var(--rim-strong), 0 1px 1px rgba(0,0,0,.24), 0 3px 6px rgba(0,0,0,.28), 0 11px 24px rgba(0,0,0,.38), 0 22px 48px rgba(0,0,0,.30);
+  --e3: var(--rim-strong), 0 2px 2px rgba(0,0,0,.26), 0 7px 14px rgba(0,0,0,.32), 0 20px 42px rgba(0,0,0,.42), 0 40px 88px rgba(0,0,0,.36);
+
+  --e1-key: var(--rim),        0 1px 1px rgba(0,0,0,.30), 0 2px 4px rgba(0,0,0,.32), 0 5px 10px rgba(0,0,0,.26);
+  --e2-key: var(--rim-strong), 0 2px 3px rgba(0,0,0,.34), 0 5px 10px rgba(0,0,0,.38), 0 10px 20px rgba(0,0,0,.30);
+
+  --carve:      inset 0 0 0 1px rgba(0,0,0,.40), inset 0 3px 6px rgba(0,0,0,.46), inset 0 -1px 0 rgba(255,255,255,.05), inset 3px 0 5px -3px rgba(0,0,0,.30), inset -3px 0 5px -3px rgba(0,0,0,.30);
+  --carve-deep: inset 0 0 0 1px rgba(0,0,0,.46), inset 0 4px 10px rgba(0,0,0,.55), inset 0 -1px 0 rgba(255,255,255,.05);
+  --press:      inset 0 0 0 1px rgba(0,0,0,.44), inset 0 3px 6px rgba(0,0,0,.50), 0 1px 0 rgba(255,255,255,.05);
+
+  --edge-up: 0 1px 0 rgba(255,255,255,.05);
+  --edge-in: inset 0 -1px 0 rgba(0,0,0,.30);
+
+  /* ── Brass, in the two jobs the design already separates.
+       --accent is a FILL and the contract on it is fixed city-wide: WHITE sits
+       on it (the pill, the step dot, the calendar's today). So it is the deep
+       bronze, which white reads on at 4.7:1 — bright gold as a fill would be
+       2.1:1 and the contract has no way to say otherwise.
+       --accent-ink is the same metal as TEXT on the charcoal, and THAT is the
+       antique gold the brief asks for: links, section labels, small accents.
+       --on-accent is deliberately NOT re-pointed. Every surface that reads it
+       is dark — the black primary button, the orange rail lamp, .tag.dark, the
+       media bar — so it stays white for all of them. ── */
+  --accent:      #8b6a42;
+  --accent-ink:  #c9a468;   /* 6.4:1 on the ground above */
+  --accent-soft: #35302c;   /* a wash on a night ground is dark, not near-white */
+  --accent-line: #6b5730;
+  --focus-ring: 0 0 0 3px rgba(184,147,85,.34);
+
+  /* ── Status. Inverted for a dark ground: the ink lightens so it can be read,
+       and the brief's own values become the hairline, where they are a fill
+       behind no words. A status that cannot be read is worse than one that is
+       not coloured — the rule does not change, only which end is light. ── */
+  --ok-ink: #8db395;     --ok-soft: #2c3a30;     --ok-line: #54765b;
+  --warn-ink: #d6ac72;   --warn-soft: #383026;   --warn-line: #a07a46;
+  --danger-ink: #d9908c; --danger-soft: #382a29; --danger-line: #8a4a48;
+  --info-ink: #9dbbcc;   --info-soft: #29323a;   --info-line: #4a6272;
+
+
+}
