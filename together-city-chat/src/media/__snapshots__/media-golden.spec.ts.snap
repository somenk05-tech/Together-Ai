exports[`media golden master extension per mime — knowns mapped, unknowns derived, never rejected 1`] = `
[
  "image/jpeg -> .jpg",
  "image/heic -> .heic",
  "image/tiff -> .tiff",
  "application/pdf -> .pdf",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document -> .docx",
  "text/csv -> .csv",
  "application/x-foo+zip -> .xfoozip",
  "application/octet-stream -> .octetstr",
  "weird/ -> .bin",
]
`;

