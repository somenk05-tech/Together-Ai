# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://tc:tc@localhost:5432/together_city_chat?schema=public

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=1209600     # 14 days (seconds)

# ── Messaging policy ────────────────────────────────
MESSAGE_EDIT_WINDOW_SEC=900         # 15 min edit window
MESSAGE_DELETE_EVERYONE_WINDOW_SEC=3600
TYPING_TIMEOUT_MS=3000
MESSAGES_PAGE_SIZE=30
MAX_UPLOAD_BYTES=52428800           # 50 MB

# ── Outbound email & SMS ────────────────────────────
# Verification codes, password-recovery OTPs and receipts leave the city through
# these. UNSET MEANS NOTHING IS DELIVERED: the stub provider logs the message and
# returns a synthetic id, so every flow works end to end in dev without a vendor
# account. In production the stub prints a loud warning on first use, and the
# verification screen tells the user nothing was actually sent rather than
# telling them to check an inbox.
#
# Setup, including the DNS that decides whether any of it reaches a Gmail
# inbox, is in docs/email-deliverability.md.

EMAIL_PROVIDER=                     # resend | stub (unset = stub)
RESEND_API_KEY=
# Must be an address on a domain VERIFIED in Resend — an unverified sender is
# rejected at the API, not silently downgraded. Defaults to
# no-reply@togethercity.app if unset.
EMAIL_FROM=Together City <no-reply@togethercity.app>

SMS_PROVIDER=                       # twilio | stub (unset = stub)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Prefer a messaging service over a bare from-number: it handles sender-ID and
# route selection, which matters in India. Set one OR the other.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Sets both channels at once when the per-channel vars above are unset. Useful
# for forcing the stub in a staging environment that otherwise has real keys.
MESSAGING_PROVIDER=

# ── Links inside outbound email ─────────────────────
# The base URL used to build links in email (the older verification link flow).
# Set it to the domain people actually see. Left unset it falls back to the raw
# Vercel hostname, which reads like phishing and costs deliverability.
WEB_APP_URL=https://togethercity.app

# ── Media storage (choose one provider) ─────────────
MEDIA_PROVIDER=r2                   # r2 | s3
MEDIA_BUCKET=together-city-media
# THE PRIVATE VAULT. A SEPARATE bucket with NO public access — blood tests,
# prescriptions, Drive files and dating photos are written here and served only
# through short-lived signed links. Leaving this unset (or pointing it at
# MEDIA_BUCKET) puts all three in the public bucket; the API refuses to boot in
# production if you do. See shared/config/configuration.ts.
MEDIA_PRIVATE_BUCKET=together-city-private
MEDIA_PUBLIC_BASE_URL=https://media.togethercity.tech
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Firebase Cloud Messaging ────────────────────────
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Calls (WebRTC) ──────────────────────────────────
# Media goes peer to peer; the API only relays the handshake. STUN lets peers
# discover their own public address and is enough for most home networks. A TURN
# relay is what makes calls work on restrictive networks (some office wifi, some
# mobile carriers) — without one, those calls ring and never connect, and
# GET /api/calls/ice says so in its `note` so the UI can warn rather than hang.
TURN_URL=                           # e.g. turn:turn.togethercity.app:3478
TURN_USERNAME=
TURN_CREDENTIAL=
# Or supply the whole RTCIceServer list as JSON (overrides nothing; adds to it):
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
ICE_SERVERS=

# ── Moderation ──────────────────────────────────────
# Who may open the moderation queue (Settings → Reported, /moderation) and the
# Real Estate and Dating moderation surfaces. Comma-separated Together City
# handles, with or without the leading @.
#
# UNSET MEANS NOBODY. That is the safe default and it is also the reason the
# queue looks broken on a fresh deployment: reports pile up, /moderation
# refuses everyone, and nothing says why. It is the single variable that has to
# be set for the console to exist at all.
#
# Three things worth knowing before you set it:
#
#   1. It is applied AT BOOT. AdminService grants User.role = 'admin' to the
#      accounts whose handle matches, when the process starts. Changing this
#      variable does nothing until the service restarts (Railway restarts on a
#      variable change by itself).
#   2. The account has to EXIST. A handle nobody has registered grants nothing,
#      silently — sign up first, then set this, then restart.
#   3. It never auto-revokes. Removing a handle from this list leaves that
#      account's role column as it was, deliberately: silently dropping
#      moderation from a live account on an unrelated deploy is worse than
#      leaving it until somebody decides. To revoke, edit this AND clear the
#      role on that user row.
#
# The listed handles are also reserved — nobody can register or rename into
# one. Authorisation reads User.role, not the handle, so taking a name can no
# longer confer moderation; reserving them closes the door as well.
MODERATION_ADMINS=
