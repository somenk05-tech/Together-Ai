// Together City — Chat schema
// Connection-gated messaging: a message may only exist between users who share
// an ACCEPTED Connection. Enforced in application layer (ConnectionPermissionService)
// and reinforced by conversation membership.

generator client {
  // Prisma 7: driver adapters and the query compiler are standard — no preview flags needed.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL no longer lives here. The CLI (migrate/db push)
  // reads it from prisma.config.ts; the app passes it via the pg driver adapter
  // in PrismaService. Both use the DATABASE_URL environment variable.
}

// ─────────────────────────── enums ───────────────────────────
enum ConnectionType {
  FRIEND
  COUPLE
  FAMILY
  BUSINESS_CUSTOMER
  DOCTOR_PATIENT
  NUTRITIONIST_CLIENT
  LAWYER_CLIENT
  MARKETPLACE_BUYER_SELLER
  EVENT_PARTICIPANT
  // Extend here — add a value + a rule in connection-permission.rules.ts
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
  REMOVED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  LOCATION
  CONTACT
  STICKER
  GIF
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
}

// ─────────────────────────── models ──────────────────────────
model User {
  id           String   @id @default(uuid())
  handle       String   @unique
  /// "citizen" | "admin". Moderation used to be decided by comparing the JWT's
  /// handle against MODERATION_ADMINS, while handles were freely renameable —
  /// so claiming a listed name granted moderation. Authorisation now reads this
  /// column, which a rename cannot change. Granted at boot from MODERATION_ADMINS.
  role         String   @default("citizen")
  name         String
  email           String? // primary (external) email — from sign-up; receipts & recovery go here
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  /// As typed by the citizen. Kept for display and for the recovery lookup that
  /// predates E.164 storage; phoneE164 is the one to compare against.
  phone        String?
  /// The same number in E.164 (+countrycode + subscriber). Nullable because a
  /// phone is optional at sign-up, and because a number typed before this
  /// column existed may not parse. Unique among VERIFIED numbers only — see the
  /// partial index in the migration, not here: two people may both have typed
  /// the same wrong number, and only one of them can prove it.
  phoneE164       String?
  phoneVerifiedAt DateTime?
  profileImage String?
  bio          String? // short public profile bio
  city         String? // public home city shown on the social profile
  website      String? // optional public link
  passwordHash String
  watchlistJson String? // Entertainment Watchlist — JSON array of saved movies/series
  lastSeen     DateTime @default(now())
  onlineStatus Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Account deletion is a SOFT delete + anonymisation: other citizens' chat
  // history references this row (Message.sender has no cascade), so hard
  // deleting would corrupt their conversations. Once set, the account can't
  // log in and is excluded from search, profiles, feeds and matching.
  deletedAt    DateTime?
  /// When this account's data was actually destroyed (30 days after deletedAt).
  /// Null means the purge has not run for them yet. See src/privacy/purge-plan.ts.
  purgedAt  DateTime?
  /// The moment every session for this account was revoked — a password reset,
  /// "sign out everywhere", or account deletion.
  ///
  /// Revoking sessions marks the REFRESH tokens revoked, which stops the next
  /// silent refresh. It does nothing to an ACCESS token already in a thief's
  /// hands: those are signed, stateless and valid for their full fifteen
  /// minutes, so "you have been signed out of all sessions" was true of the
  /// next quarter of an hour and not of this one. JwtStrategy compares this
  /// against the token's `iat` on every request and refuses anything issued
  /// before it. Null for accounts that have never revoked.
  sessionsRevokedAt DateTime?
  /// Suspended by the console. NOT a deletion and not reversible by the citizen:
  /// they keep their data, they cannot sign in, and restoring is one field.
  ///
  /// Separate from deletedAt on purpose. Reusing that column would have made a
  /// suspension indistinguishable from an account the citizen closed themselves
  /// — in the purge plan, in the "already gone" branches of auth, and in every
  /// count anybody runs afterwards. A punishment and a departure are not the
  /// same event.
  suspendedAt     DateTime?
  /// Why, in the suspending admin's words. Never shown to the citizen by this
  /// column — the sign-in refusal is deliberately plain — but it is what the
  /// next admin reads before deciding whether to restore.
  suspendedReason String?

  connectionsInitiated Connection[]         @relation("ConnectionUserOne")
  connectionsReceived  Connection[]         @relation("ConnectionUserTwo")
  driveFolders         DriveFolder[]
  driveFiles           DriveFile[]
  memberships          ConversationMember[]
  messages             Message[]            @relation("MessageSender")
  messageStatuses      MessageStatus[]
  refreshTokens        RefreshToken[]
  deviceTokens         DeviceToken[]

  foodPref             FoodPref?
  ownRecipes           Recipe[]             @relation("RecipeAuthor")
  mealPlans            MealPlan[]
  calorieEntries       CalorieEntry[]
  foodJournalEntries   FoodJournalEntry[]
  groceryCarts         GroceryCart[]
  walletLedger         WalletLedger[]
  nutritionOrders      NutritionOrder[]
  bloodMarkers         BloodMarker[]
  medicalBloodTests    MedicalBloodTest[]
  medicalRecords       MedicalRecord[]
  doctorProfile        Doctor?
  consults             Consult[]
  medicalConsents      MedicalConsent[]
  privacySettings      PrivacySetting[]
  beautyProfile        BeautyProfile?
  beautyOrders         BeautyOrder[]
  supplementBag        SupplementBag?
  supplementOrders     SupplementOrder[]
  fitnessProfile       FitnessProfile?
  workoutLogs          WorkoutLog[]
  cityWallet           CityWallet?
  miraPass             MiraPass?
  miraTurns            MiraTurn[]
  dayPages             DayPage[]
  dayItems             DayItem[]
  dayPhotos            DayPhoto[]
  walletTxns           WalletTxn[]
  masterProfile        MasterProfile?
  astroProfile         AstroProfile?
  astroQuestions       AstroQuestion[]
  astroReadings        AstroReading[]
  tarotReadings        TarotReading[]
  budgets              Budget[]
  spendLog             SpendLogEntry[]
  jobProfile           JobProfile?
  jobsPosted           Job[]
  jobApplications      JobApplication[]
  properties           Property[]
  serviceListings      ServiceListing[]
  serviceEnquiries     ServiceEnquiry[]
  serviceRegulars      ServiceRegular[]
  serviceReviews       ServiceReview[]
  ticketBookings       TicketBooking[]
  tripBookings         TripBooking[]
  diningOrders         DiningOrder[]
  reservations         Reservation[]
  mailAccount          MailAccount?
  mailMessages         MailMessage[]
  mailProjects         MailProject[]
  emailDeliveries      EmailDelivery[]
  passwordResets       PasswordReset[]
  verificationCodes    VerificationCode[]
  profileChanges       ProfileChange[]
  dietitianProfile     Dietitian?
  dietitianBookings    DietitianBooking[]

  posts                Post[]
  postComments         Comment[]
  postLikes            Like[]
  following            Follow[]             @relation("FollowFollower")
  followers            Follow[]             @relation("FollowFollowee")
  blocksMade           Block[]              @relation("BlocksMade")
  blocksReceived       Block[]              @relation("BlocksReceived")
  reportsMade          Report[]             @relation("ReportsMade")
  datingProfile        DatingProfile?
  datingMatchesOne     DatingMatch[]        @relation("DatingUserOne")
  datingMatchesTwo     DatingMatch[]        @relation("DatingUserTwo")

  prescriptions        Prescription[]
  medicines            Medicine[]
  medicineSchedules    MedicineSchedule[]
  thoughts             Thought[]
  lookAnalyses         LookAnalysis[]
  avatars              Avatar[]
  callsCreated         CallSession[]
  callParticipations   CallParticipant[]

  @@index([onlineStatus])
  dailyTargets      DailyTargetSnapshot[]
  groceryList       GroceryListItem[]
  adminGrants  AdminGrant[] @relation("adminGrantHolder")
  adminAudits  AdminAudit[] @relation("adminAuditActor")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  device     String? // user-agent fingerprint, for the "active sessions" list
  ip         String? // last-seen IP (coarse), for session review
  lastUsedAt DateTime @default(now()) // updated on each silent refresh
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String // ios | android | web
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A single, order-independent connection between two users.
// userOneId is always the lexicographically-smaller id (enforced in service)
// so (userOneId,userTwoId,connectionType) is a stable unique key.
model Connection {
  id             String           @id @default(uuid())
  userOneId      String
  userTwoId      String
  connectionType ConnectionType
  status         ConnectionStatus @default(PENDING)
  requestedById  String // who initiated (for accept/decline UX)
  relationship   String? // family | friend | partner | colleague | other
  modulesJson    String? // JSON string[] — module permissions granted on this ONE record (chat, social, nutrition, medical, travel, entertainment, financial, jobs, beauty, fitness). Universal Connection Model: every hub queries this, no per-hub invites.
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userOne User @relation("ConnectionUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("ConnectionUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId, connectionType])
  @@index([userOneId, status])
  @@index([userTwoId, status])
  @@index([status])
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DIRECT)
  title     String? // group only
  // For DIRECT conversations, a deterministic key of the two member ids so we
  // never create duplicates. Null for groups.
  directKey String?          @unique
  // Dating-match anonymity: null = normal chat. 1 = anonymous (show pseudonym),
  // 2 = identities revealed, 3 = friends. Only set on dating-originated chats.
  anonymousTrust Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
  calls    CallSession[]

  @@index([type])
}

model ConversationMember {
  id             String     @id @default(uuid())
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  lastReadAt     DateTime? // for unread counts
  muted          Boolean    @default(false)
  archived       Boolean    @default(false)
  /// This reader has chosen to see the conversation as unread again.
  /// A separate flag rather than a rewind of lastReadAt, which is a
  /// high-water mark that never moves backwards by design.
  markedUnread   Boolean    @default(false)
  pinned         Boolean    @default(false)
  /// Per-participant chat deletion. Deleting a chat from the left panel is not
  /// a shared act — the other person keeps their copy — so it records a moment
  /// rather than removing rows: messages at or before this instant are hidden
  /// from THIS member, and the conversation leaves their list until someone
  /// writes to it again. Null means nothing has been cleared.
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id               String      @id @default(uuid())
  conversationId   String
  senderId         String
  text             String?
  messageType      MessageType @default(TEXT)
  replyToMessageId String?
  shareJson        String? // a shared hub item (flight/product/property/…) rendered as a rich card
  edited           Boolean     @default(false)
  deleted          Boolean     @default(false) // "delete for everyone" (soft delete — row kept)
  deletedAt        DateTime?   // when delete-for-everyone happened
  deletedById      String?     // who deleted it
  hiddenForJson    String?     // JSON userId[] — users who chose "delete for me"
  /// JSON userId[] — who has kept this message. A star is the READER's
  /// bookkeeping: two people can star the same row and neither sees the
  /// other's. Same shape as hiddenForJson deliberately, so the two
  /// per-reader facts about a message are read the same way.
  starredForJson   String?
  /// JSON { "<emoji>": userId[] } — who answered this message with what.
  /// SHARED, unlike starredForJson directly above it: a star is the reader's
  /// own bookkeeping and nobody else sees it, a reaction is addressed to the
  /// room. One per person, so a userId appears under at most one key and
  /// choosing a second replaces the first.
  reactionsJson    String?
  /// ONE PIN PER CONVERSATION: pinning another message clears these, so the
  /// pair answers "what is pinned here" without a second table. A pin is a
  /// fact about the room rather than about the reader, which is why it is not
  /// a per-viewer list. ConversationMember.pinned is a different feature — it
  /// pins a CONVERSATION in somebody's panel.
  pinnedAt         DateTime?
  pinnedById       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      Message?        @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies      Message[]       @relation("MessageReply")
  attachments  Attachment[]
  statuses     MessageStatus[]

  @@index([conversationId, createdAt]) // cursor pagination + ordering
  @@index([conversationId, pinnedAt]) // "what is pinned in this room" — one row
  @@index([senderId])
  @@index([createdAt])
}

model MessageStatus {
  id        String         @id @default(uuid())
  messageId String
  userId    String // the recipient this status is for
  status    DeliveryStatus @default(SENT)
  readAt    DateTime?
  updatedAt DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, status])
  @@index([messageId])
}

model Attachment {
  id        String  @id @default(uuid())
  messageId String
  url       String
  thumbnail String?
  size      Int
  mimeType  String
  /// The name the file had on the sender's machine. Storage keys are
  /// `uploads/<user>/<uuid>.<ext>` by design — good for storage, useless to a
  /// recipient, who needs to know they were sent "lease-agreement.pdf" and not
  /// "9f2c….pdf". Nullable: everything sent before this column existed, and
  /// every voice note, has no name to remember.
  name      String?
  duration  Int? // seconds (voice/video)
  width     Int?
  height    Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ─────────────────────────── Nutrition Hub ───────────────────────────
// Diet + slot are stored as lowercase strings to match the frontend contract
// (Recipe.diet: 'veg'|'nonveg'|'pesc'|'egg'|'vegan'|'jain'|'everything', Slot: b|l|s|d).

model FoodPref {
  /// When the citizen actually answered — NULL means this row holds nothing but
  /// column defaults, created at registration. Anything reading these values as
  /// the citizen's own must check this first: the defaults read like answers
  /// ("everything", "maintain", age 35) and cannot be told apart from real ones
  /// by inspecting them.
  answeredAt DateTime?
  id        String   @id @default(uuid())
  userId    String   @unique
  diet      String   @default("everything")
  goal      String   @default("maintain") // lose | maintain | gain
  heightCm  Int?
  weightKg  Int?
  age       Int?
  sex       String? // male | female
  activity  Float    @default(1.4)
  extras    String? // JSON: cuisines, protein sources, meats, allergies, excluded foods, nutrition pattern, max cook time, conditions, budget, delivery, weekly plan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id              String @id @default(uuid())
  recipeNo        Int? // stable public recipe number (1..N) for the world library
  name            String
  country         String
  slot            String // b | l | s | d
  kcal            Int
  protein         Int
  carbs           Int
  fat             Int
  fiber           Int
  minutes         Int
  gramsPerServing Int
  diet            String
  servings        Int     @default(0) // 0 = batch totals (estimate servings); >0 = per-serving data (v2 dataset)
  healthGrade     String? // A–E health grade (v2 dataset)
  healthPercent   Int     @default(0) // 0–100 health score (v2 dataset)
  qaVersion       Int     @default(0) // nutrition-QA pass version applied to this row
  steps           String? // cached JSON array of cooking-method steps
  cookSteps       String? // cached JSON of structured cook steps [{text,durationSec,active}]

  /// NULL = the vetted world corpus, visible to everyone. Set = one citizen's
  /// own dish, visible only to them and only in their planning pool.
  authorId        String?
  /// 'computed' — worked out from the ingredient list by the same Atwater audit
  /// the corpus gets. 'author' — typed by the citizen after seeing the computed
  /// figures, and marked as theirs wherever the dish is shown.
  nutritionSource String @default("computed")
  /// 0–100: how much of the ingredient mass the nutrition table recognised.
  /// Below 60 the numbers are an estimate and the app says so.
  coveragePct     Int    @default(100)

  ingredients RecipeIngredient[]
  meals       Meal[]
  author      User? @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slot])
  @@index([diet])
  @@index([recipeNo])
  @@index([authorId])
}

// A single logged food/drink item in the My Health Profile calorie tracker.
// Persisted per user per local day so the week strip builds over time.
model FoodJournalEntry {
  id        String   @id @default(uuid())
  userId    String
  /// When the meal was eaten (the citizen's claim, defaulting to "now").
  at        DateTime
  /// breakfast | morning-snack | lunch | evening-snack | dinner | other
  mealType  String
  /// photo | text | voice | plan | manual — how this entry was captured.
  source    String
  /// JSON: [{ name, qty, unit, grams?, kcal, proteinG, carbG, fatG, fibreG?,
  /// sugarG?, sodiumMg?, waterMl?, confidence? }] — per-item AI ESTIMATES the
  /// citizen reviewed (and could adjust) before logging. Estimates, not
  /// measurements; every surface that shows them says so.
  itemsJson String
  /// JSON: summed totals of itemsJson, computed SERVER-side at write time.
  totalsJson String
  photoUrl  String?
  /// The AI's read of the photo/text (confidence caveats, what it could not
  /// see). Kept verbatim so the citizen can judge the estimate later.
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

model CalorieEntry {
  id        String   @id @default(uuid())
  userId    String
  date      String // YYYY-MM-DD (the user's local day)
  name      String
  kcal      Int
  type      String // Meal Plan | Extra | Alcohol
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  grams    Int
  priceInr Int    @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  /// Ingredient search hits this — without it, "recipes containing tomato"
  /// was a full-table scan, which is why search was capped to a 300-row slice.
  @@index([name])
}

model MealPlan {
  id        String    @id @default(uuid())
  key       String    @unique
  userId    String
  mode      String    @default("individual") // individual | family
  weekStart DateTime? // Monday of the calendar week this plan is FOR (null = legacy → derive from createdAt)
  createdAt DateTime  @default(now())
  /// When the citizen last changed this plan themselves — a swap, a skip, a
  /// portion. Once set, the plan is their decision rather than the generator's:
  /// it loads exactly as they left it on every login, and anything that would
  /// replace it has to say so first. Null means untouched since generation.
  editedAt  DateTime?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days MealPlanDay[]

  @@index([userId, mode])
  @@index([userId, mode, weekStart])
}

model MealPlanDay {
  id       String @id @default(uuid())
  planId   String
  dayIndex Int // 0..6
  dayName  String

  plan  MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@unique([planId, dayIndex])
  @@index([planId])
}

model Meal {
  id         String  @id @default(uuid())
  dayId      String
  slot       String // b | l | s | d
  recipeId   String
  skipped    Boolean @default(false)
  portionPct Int     @default(100) // quantized portion (50/75/100/125/150) — set by the day optimizer
  addonsJson String? // complement foods on the plate: [{key, units}] — fills energy gaps realistically
  sidesRice  Int     @default(0)
  sidesRoti  Int     @default(0)
  sidesCurd  Int     @default(0)
  sidesSalad Int     @default(0)

  day    MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipe Recipe      @relation(fields: [recipeId], references: [id])

  @@index([dayId])
  @@index([recipeId])
}

/// The daily targets that were actually in force on one calendar day (BE-7.4).
///
/// The plan is regenerated, the profile changes, the equation itself gets fixed
/// — and without this, yesterday's intake is scored against today's target.
/// That reads as progress or failure that never happened.
///
/// `day` is the CITIZEN'S calendar day, not a UTC one. Immutable once the day
/// has passed; today's row is replaced when the target genuinely changes,
/// because the target in force today did change. Nothing rewrites a past day.
model DailyTargetSnapshot {
  id     String @id @default(uuid())
  userId String
  /// YYYY-MM-DD in the citizen's timezone, which is stored with it so a later
  /// reader knows which day this was without guessing.
  day      String
  timezone String
  kcal    Int
  protein Int
  carb    Int
  fat     Int
  fiber   Int
  /// JSON: the whole prescription, so a past day can be explained and not just
  /// compared. Same convention as NutritionHistory.targets.
  payload String
  /// False when the target was built on substituted inputs — a snapshot of a
  /// number that was never really theirs, kept so history does not silently
  /// treat it as if it were.
  personalised Boolean  @default(true)
  computedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

/// Permanent, versioned snapshot of a generated weekly meal plan — nutrition
/// history (spec §19). One immutable row per generation; NEVER overwritten, so a
/// user's nutrition journey can be tracked over months/years. JSON stored as
/// String (same convention as BloodAnalysis.payload / FoodPref.extras).
model NutritionHistory {
  id         String   @id @default(uuid())
  userId     String
  mode       String   @default("individual") // individual | family
  planKey    String // the live plan this snapshot was taken from
  weekNumber Int // 1..N for this user+mode
  weekLabel  String // e.g. "Week of 2026-07-20"
  startDate  DateTime
  endDate    DateTime
  targets    String // JSON: personalised nutrition targets used
  context    String // JSON: blood version, medical conditions, cuisine mix, weekly schedule, diet/goal, profile version
  days       String // JSON: per-day meals (per-meal macros/cost/time) + daily totals + coverage
  weekly     String // JSON: weekly totals, variety scores, cuisine/protein distribution
  cost       Int      @default(0) // estimated weekly food cost (₹)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, mode, createdAt])
}

/// Admin-managed family member sub-profile (Family Meal Planner §). The account
/// holder creates one per person (no separate login); each carries their own
/// biometrics, diet, goal and medical conditions so the family plan can compute
/// per-member targets and portions. JSON extras (proteins/cuisines/allergies/
/// healthConditions) stored as String, mirroring FoodPref.extras.
model FamilyMember {
  id           String   @id @default(uuid())
  ownerId      String // the User who manages this member (household owner)
  memberUserId String? // set when this row mirrors a real invited Together City user (Household Connection)
  name         String
  role         String   @default("member") // household role: owner | adult | child | guest (legacy: father|mother|child|self|member)
  /// NULL means nobody has told us. These four were NOT NULL with defaults
  /// "male" / 30 / 170 / 65 — a reference body written into a table and
  /// indistinguishable from a real answer, exactly the trap FoodPref documents.
  /// computeTargets then saw a complete body, `readiness` came back ok, and the
  /// refusal that exists so nobody is shown a target computed for somebody else
  /// could never fire for a family member.
  ///
  /// activity and goal keep their defaults: sedentary and maintain are true of a
  /// real population. There is no honest default for how much somebody weighs.
  sex          String?
  age          Int?
  heightCm     Int?
  weightKg     Float?
  activity     Float    @default(1.4)
  goal         String   @default("maintain") // lose | maintain | gain
  diet         String   @default("everything")
  extras       String? // JSON: proteins[], cuisines[], allergies, healthConditions[]
  isSelf       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@index([memberUserId])
}

// One shared pantry per household (owned by ownerId). Updated when groceries are
// ordered (stocked) or meals are cooked (drawn down). Private to Nutrition Hub.
model PantryItem {
  id        String   @id @default(uuid())
  ownerId   String // household owner (User.id)
  name      String // canonical shopping item, e.g. "Tomatoes"
  aisle     String   @default("pantry") // supermarket aisle key
  grams     Int      @default(0) // on-hand quantity in grams / ml
  /// The high-water mark this item was last stocked to. It is the DENOMINATOR
  /// for the depletion bar ("how full is this jar"), so cooking can visibly
  /// draw it down and re-stocking refills it.
  startGrams Int     @default(0)
  unit      String   @default("g") // display unit class: g | kg | ml | l | pc | bunch
  qtyLabel  String   @default("") // human-readable amount, e.g. "1.8 kg"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// One cooked meal's draw-down on the pantry. Exists so cooking the same meal
/// twice can't double-deduct (idempotency) and so "what did we get through this
/// week" is answerable.
model PantryConsumption {
  id        String   @id @default(uuid())
  ownerId   String
  /// Stable key for the cooked meal: "<planDayISO>:<slot>" — one draw per meal.
  mealKey   String
  label     String   @default("")
  itemsJson String   @default("[]") // [{name, grams}] actually deducted
  createdAt DateTime @default(now())

  @@unique([ownerId, mealKey])
  @@index([ownerId, createdAt])
}

// A Household Connection between two real Together City users — PRIVATE to the
// Nutrition Hub. This is DELIBERATELY separate from the social `Connection`
// model: accepting a household invite never creates a friend/follow/social tie,
// and a social connection never creates a household one. The owner (ownerId) is
// the account whose family plan/grocery/dashboard the member joins.
model HouseholdMember {
  id            String   @id @default(uuid())
  ownerId       String // household owner (User.id)
  memberUserId  String // invited citizen (User.id)
  role          String   @default("adult") // owner | adult | child | guest
  status        String   @default("pending") // pending | accepted | declined | removed
  requestedById String // who sent the invite (always the owner)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, memberUserId])
  @@index([ownerId, status])
  @@index([memberUserId, status])
}

model GroceryCart {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id       String @id @default(uuid())
  cartId   String
  name     String
  category String // shelf-life bucket: pantry | weekly | daily  (spec: Smart Grocery Planner)
  qty      Int    @default(1) // legacy numeric qty (pieces or coarse units) — display uses qtyLabel
  grams    Int    @default(0) // exact total grams/ml derived from the meal plan
  unit     String @default("") // display unit class: g | kg | ml | l | pc | bunch
  qtyLabel String @default("") // human-readable amount, e.g. "1.8 kg", "18", "2 bunches"
  priceInr Int    @default(0)

  cart GroceryCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

/// One line on a citizen's shopping list, and whether it is in the basket yet
/// (BE-11.1).
///
/// Check state used to live in a React useState, so it survived exactly as long
/// as the page did. Somebody halfway round a supermarket who switched apps or
/// let the screen lock came back to a list with nothing ticked. This is a list
/// people use while standing up and holding something else.
///
/// Keyed by (user, key) where key is the canonical item name, so REGENERATING
/// THE PLAN MERGES rather than replaces: a line that is still needed keeps its
/// tick, a line that is no longer needed drops out, and anything added by hand
/// stays because nothing generated it in the first place.
model GroceryListItem {
  id     String @id @default(uuid())
  userId String
  /// Canonical item name, lower-cased — the merge key.
  key      String
  /// What to show. May change wording between regenerations; `key` may not.
  label    String
  aisle    String  @default("")
  qtyLabel String  @default("")
  checked  Boolean @default(false)
  /// plan | manual. A manual line is never removed by a regeneration; the
  /// citizen put it there and the planner does not know why.
  source    String   @default("plan")
  checkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, checked])
}

model WalletLedger {
  id        String   @id @default(uuid())
  userId    String
  amountInr Int
  kind      String // credit | debit | refund
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Social Hub ───────────────────────────

model Post {
  id        String   @id @default(uuid())
  authorId  String
  text      String?
  feeling   String?
  audience  String   @default("public") // public | friends | family | private
  /// visible | removed. Set by a moderator acting on a report. Every list read
  /// of Post filters on it — social/post-visibility.ts is the single definition
  /// and moderation-reach.spec.ts is what stops a new read path forgetting.
  moderation String  @default("visible")
  sortIndex Int? // author's custom order on their profile grid (null = unarranged, falls back to newest-first)
  category  String? // 'work' | 'personal' — author's own sorting on their profile
  musicUrl  String? // attached royalty-free track (plays over the video in reels)
  musicTitle String?
  repostOfId String? // set when this post is a repost/share of another post
  placeName String? // check-in / travel location label
  taggedJson String? // JSON [{id, name, handle}] — tagged friends
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  comments Comment[]
  likes    Like[]
  repostOf Post?       @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts  Post[]      @relation("PostReposts")

  @@index([createdAt])
  @@index([authorId])
  @@index([moderation])
  // Serves the hot feed path: WHERE authorId IN (...) ORDER BY createdAt DESC.
  @@index([authorId, createdAt])
  @@index([repostOfId])
}

model PostMedia {
  id       String  @id @default(uuid())
  postId   String
  url      String
  kind     String // image | video
  thumbUrl String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// Safety: one user blocking another. Blocks are one-directional records but
// enforced both ways (a block hides content and prevents interaction between
// the pair in either direction). Cascade-deletes with either user.
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Safety: a user-submitted report against a user, post or comment. Feeds a
// moderation queue (reviewed out-of-band). Kept minimal and append-only.
model Report {
  id         String   @id @default(uuid())
  reporterId String
  targetType String // user | post | comment
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  /// open | actioned | dismissed. What the reporter wrote is never edited; this
  /// records whether anybody has looked at it. See SocialService.reportQueue.
  status       String    @default("open")
  reviewedById String?
  reviewedAt   DateTime?
  /// The moderator's note. Read by nobody but the next moderator.
  decision     String?

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([status, createdAt])
}

// ─────────────────────────── Dating Hub ───────────────────────────
// Astrology-first: birth details feed the compatibility engine. Matches are
// order-independent pair rows (userOneId = smaller id), like Connection.

// Precomputed pair compatibility — refreshed whenever matches are generated.
model CompatibilityScore {
  id               String   @id @default(uuid())
  userA            String
  userB            String
  astrology        Int
  personality      Int
  relationshipGoal Int
  values           Int
  lifestyle        Int
  interest         Int
  distance         Int
  overall          Int
  lastCalculated   DateTime @updatedAt

  @@unique([userA, userB])
  @@index([userA, overall])
}

// Activity Dating — a host posts a plan; the AI invites the most compatible
// people; invitees connect or pass; mutual connect opens an anonymous chat that
// can progress through trust levels.
model DatingActivity {
  id          String   @id @default(uuid())
  hostId      String
  text        String // "Watch the new Superman movie."
  category    String // restaurant | theatre | cafe | park | city | any
  date        String // YYYY-MM-DD
  time        String? // HH:MM
  groupSize   String   @default("1") // 1 | 2-4 | group
  description String?
  createdAt   DateTime @default(now())

  @@index([hostId])
}

model ActivityInvite {
  id             String   @id @default(uuid())
  activityId     String
  invitedUserId  String
  compatibility  Int
  status         String   @default("pending") // pending | connected | passed
  trustLevel     Int      @default(1) // 1 anonymous · 2 revealed · 3 friends
  invitedReveal  Boolean  @default(false)
  hostReveal     Boolean  @default(false)
  invitedFriends Boolean  @default(false)
  hostFriends    Boolean  @default(false)
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([invitedUserId, status])
  @@index([activityId])
}

model DatingProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  gender     String // male | female | nonbinary
  seeking    String // male | female | nonbinary | any
  bio        String?
  birthDate  DateTime
  birthTime  String?
  birthPlace String?
  interests  String   @default("") // csv
  extras     String? // JSON: extended profile (lifestyle, personality, match prefs, photos…)
  moderation String   @default("approved") // approved | pending | rejected | review
  moderationJson String? // JSON: { decision, confidence, checks[], reasons[] }
  visible    Boolean  @default(true)
  connectCount Int    @default(0) // dating chats this user has connected to (first 3 free)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DatingMatch {
  id             String   @id @default(uuid())
  userOneId      String
  userTwoId      String
  kind           String   @default("romantic") // romantic | platonic
  status         String   @default("pending") // pending | matched | passed
  likedByOne     Boolean  @default(false)
  likedByTwo     Boolean  @default(false)
  passedByOne    Boolean  @default(false)
  passedByTwo    Boolean  @default(false)
  revealByOne    Boolean  @default(false) // dating chat: userOne agreed to reveal identity
  revealByTwo    Boolean  @default(false) // dating chat: userTwo agreed to reveal identity
  // WHEN, not just whether (M2). Undo needs to know which pass was last, and a
  // daily limit needs something to count; updatedAt moves for reveals and
  // unmatches too, so it can answer neither. A NULL passedAt on a passed row
  // means "passed before we recorded when" — undo leaves those alone.
  likedAtOne     DateTime?
  likedAtTwo     DateTime?
  passedAtOne    DateTime?
  passedAtTwo    DateTime?
  // A super-like is a like that says so. Scarce by the day, never by payment.
  superByOne     Boolean  @default(false)
  superByTwo     Boolean  @default(false)
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userOne User @relation("DatingUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("DatingUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId, kind])
  @@index([userOneId, status])
  @@index([userTwoId, status])
  @@index([userOneId, likedAtOne])
  @@index([userTwoId, likedAtTwo])
  @@index([userOneId, passedAtOne])
  @@index([userTwoId, passedAtTwo])
}

// ─────────────── Nutrition Hub: orders, deliveries & wallet ───────────────

model NutritionOrder {
  id        String   @id @default(uuid())
  userId    String
  totalInr  Int
  status    String   @default("placed") // placed | cancelled
  qcJson    String? // quick-commerce metadata: provider, ETA, rider, timeline
  createdAt DateTime @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      NutritionOrderItem[]
  deliveries FreshDelivery[]

  @@index([userId, createdAt])
  /// Where this order is delivered. Nullable only because orders placed before
  /// the field existed have none — the API requires it on every new order, and
  /// the most recent one is offered back as the default next time.
  deliveryAddress String?
}

model NutritionOrderItem {
  id       String @id @default(uuid())
  orderId  String
  name     String
  category String // fresh | pantry
  qty      Int    @default(1)
  priceInr Int    @default(0)

  order NutritionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model FreshDelivery {
  id        String   @id @default(uuid())
  orderId   String
  dayIndex  Int // 0..6 within the order week
  date      DateTime
  status    String   @default("scheduled") // scheduled | delivered | cancelled
  amountInr Int      @default(0)

  order NutritionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────── Nutrition Hub: blood panel & expert care ───────────────

model BloodMarker {
  id        String   @id @default(uuid())
  userId    String
  key       String // hb | vitd | b12 | ferritin | hba1c | ldl
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Dietitian {
  id        String @id @default(uuid())
  userId    String @unique // dietitians are Users, so booking opens a real chat
  specialty String
  languages String // csv
  rating    Float  @default(4.8)
  priceInr  Int

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings DietitianBooking[]
}

model DietitianBooking {
  id             String   @id @default(uuid())
  userId         String
  dietitianId    String
  conversationId String?
  createdAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietitian Dietitian @relation(fields: [dietitianId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Medical Hub ───────────────────────────
// Source of truth for health data. Dated blood-test panels give history/trends;
// other hubs (Nutrition, Beauty, Fitness) read biomarkers by reference with consent.

model MedicalBloodTest {
  id        String   @id @default(uuid())
  userId    String
  takenOn   DateTime @default(now())
  lab       String?
  aiSummary String? // legacy inline cache (superseded by BloodAnalysis); kept to avoid a destructive drop
  createdAt DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  biomarkers MedicalBiomarker[]
  analyses   BloodAnalysis[]

  @@index([userId, takenOn])
}

/**
 * The single, stored result of analysing one blood test at one analysis version.
 * The AI runs ONCE when a test is uploaded/changed (or the version bumps); every
 * consumer (Medical Hub, Nutrition, dashboard, meal planner) reads this record
 * instead of re-calling the AI. `reportHash` lets an identical re-upload reuse an
 * existing analysis. Old versions are kept so improvements don't lose history.
 */
model BloodAnalysis {
  id              String   @id @default(uuid())
  bloodTestId     String
  userId          String
  analysisVersion String // e.g. "v1" — bump when the prompt/model changes
  model           String // model id that produced the narrative
  reportHash      String // SHA-256 of the biomarker values (dedup identical reports)
  healthScore     Int
  band            String
  payload         String // full analysis JSON (markers, conditions, narrative, restrictions, supplements)
  analyzedAt      DateTime @default(now())

  bloodTest MedicalBloodTest @relation(fields: [bloodTestId], references: [id], onDelete: Cascade)

  @@unique([bloodTestId, analysisVersion])
  @@index([userId, analyzedAt])
  @@index([reportHash, analysisVersion])
}

model MedicalBiomarker {
  id          String @id @default(uuid())
  bloodTestId String
  key         String // hb | ferritin | vitd | b12 | folate | hba1c | ldl | trig | crp | ...
  /// The value in the unit this marker's reference range is stated in
  /// (biomarker-catalog.ts). DERIVED, when enteredUnit is something else.
  value       Float
  /// What the citizen's own report actually printed. `value` above is this put
  /// into the catalog's unit, so the record stays theirs and the comparison
  /// stays ours — and if a conversion factor is ever found wrong, the affected
  /// rows can be recomputed instead of being lost. Null on every row written
  /// before units were asked for: those genuinely do not know, and saying so
  /// is better than backfilling a unit nobody chose.
  enteredValue Float?
  enteredUnit  String?
  /// The reference interval the citizen's OWN lab printed beside this value, in
  /// the same canonical unit as `value` — converted through the same
  /// toCanonical() call, or not stored at all. Null on every panel taken before
  /// BE-3.2b and on any row whose interval could not be read or converted
  /// safely; those keep being judged against the general adult band and keep
  /// the caveat that says so. Either bound may be null on a row that has the
  /// other: "< 5.0" states an upper bound and no lower one, and inventing a
  /// zero would be inventing the lab's opinion.
  refLow       Float?
  refHigh      Float?

  bloodTest MedicalBloodTest @relation(fields: [bloodTestId], references: [id], onDelete: Cascade)

  @@index([bloodTestId])
}

// ─────────────── Medical Hub: records, consults & consent ───────────────

model MedicalRecord {
  id         String   @id @default(uuid())
  userId     String
  kind       String // prescription | report | condition | allergy | vaccination | note
  title      String
  detail     String?
  fileUrl    String? // public URL of the uploaded document (R2)
  fileKey    String? // R2 object key (for deletion)
  mimeType   String? // application/pdf | image/jpeg | image/png
  sizeBytes  Int      @default(0) // counts against the citizen's shared 10 GB vault
  bloodTestId String? // if this document produced a parsed blood panel, link it
  recordedOn DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedOn])
}

model Doctor {
  id        String @id @default(uuid())
  userId    String @unique // doctors are Users — booking opens a real chat
  specialty String
  hospital  String?
  languages String // csv
  rating    Float  @default(4.8)
  priceInr  Int

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consults Consult[]
}

model Consult {
  id             String    @id @default(uuid())
  userId         String
  doctorId       String
  reason         String?
  scheduledAt    DateTime?
  conversationId String?
  status         String    @default("booked") // booked | completed | cancelled
  createdAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Consent core: which hubs may read the user's Medical biomarkers.
model MedicalConsent {
  id        String   @id @default(uuid())
  userId    String
  hub       String // nutrition | beauty | fitness
  granted   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hub])
  @@index([userId])
}

// Contextual consent + granular privacy permissions (audit 2.2). One row per
// (user, key): key is "tos", "ack:<hub>", or "pref:<permission>"; value is a
// short string ("true"/"false"). Durable, cross-device record behind the client
// privacy store.
model PrivacySetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ─────────────────────────── Beauty Hub ───────────────────────────
// Beauty personalises skin/hair from the user's stated profile and — with
// consent — from the biomarkers the Medical Hub owns (see MedicalConsent).
model BeautyProfile {
  /// When the citizen actually answered — NULL means this row holds nothing but
  /// column defaults, created at registration. Anything reading these values as
  /// the citizen's own must check this first: the defaults read like answers
  /// ("everything", "maintain", age 35) and cannot be told apart from real ones
  /// by inspecting them.
  answeredAt DateTime?
  id           String   @id @default(uuid())
  userId       String   @unique
  skinType     String   @default("normal") // dry | oily | combination | normal | sensitive
  hairType     String   @default("straight") // straight | wavy | curly | coily
  concerns     String   @default("") // csv of concern keys (legacy quick concerns)
  extras       String? // JSON: full skin & hair profile (goals, tone, routine, allergies, conditions, budget…)
  photosJson   String   @default("[]") // JSON [{slot, analyzedAt, findings[]}] — latest photo assessment
  progressJson String   @default("[]") // JSON [{id, date, findings[], score, thumb}] — weekly progress timeline
  analysisJson String? // JSON: saved one-time assessment (skin + hair attribute readings, issues, recommendations)
  analysisLogJson String? // JSON [iso timestamps] — every photo analysis run (rate-limits re-uploads; survives deletes)
  faceJson     String? // JSON: AI face-feature read from the photos (face/eye/brow/lip shape, tone) — powers Makeup Studio
  analyzedAt   DateTime? // when the saved assessment was generated (no re-analysis until re-saved)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BeautyOrder {
  id        String   @id @default(uuid())
  userId    String
  itemsJson String // JSON array of {id,name,priceInr,qty}
  totalInr  Int
  status    String   @default("placed") // placed | cancelled
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// THE SUPPLEMENT BAG — one per citizen, and the only place a basket lives.
///
/// A JSON column rather than a row per line, for the reason Beauty's bag is
/// the same shape: a bag is replaced wholesale on every change, it is never
/// queried across citizens, and nothing joins to a line of it. Two tables and
/// a foreign key would buy referential integrity over a list that is rewritten
/// in full a moment later.
///
/// IT HOLDS IDS AND QUANTITIES AND NOTHING ELSE. No price is stored here. The
/// bag is a statement of intent; what it costs is read off the shelf every
/// time it is displayed and again when it is paid for, so a bag left open for
/// a week cannot lock in yesterday's number.
model SupplementBag {
  id        String   @id @default(uuid())
  userId    String   @unique
  linesJson String   @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A SUPPLEMENT ORDER — the receipt, priced on the day.
///
/// `itemsJson` is a snapshot of what was charged, NOT a list of ids to look up
/// later. A receipt that changes when a shelf price changes is not a receipt,
/// and a product removed from the catalogue must not erase the fact that
/// somebody bought it.
///
/// This exists before any route that takes money does. Nutrition's grocery
/// checkout charged the wallet and wrote seven delivery rows that nothing in
/// the app ever rendered — the citizen paid and had nowhere to see what they
/// had bought — and it was removed for exactly that. GET /fitness/store/orders
/// is why this table is allowed to be written to.
model SupplementOrder {
  id        String   @id @default(uuid())
  userId    String
  itemsJson String
  totalInr  Int
  status    String   @default("placed") // placed | cancelled
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────── Fitness Hub ───────────────────────────
// Age- and condition-differentiated training. Reads biomarkers (iron, glucose,
// inflammation) from the Medical Hub via consent, like Beauty.
model FitnessProfile {
  /// When the citizen actually answered — NULL means this row holds nothing but
  /// column defaults, created at registration. Anything reading these values as
  /// the citizen's own must check this first: the defaults read like answers
  /// ("everything", "maintain", age 35) and cannot be told apart from real ones
  /// by inspecting them.
  answeredAt DateTime?
  id         String   @id @default(uuid())
  userId     String   @unique
  age        Int      @default(35)
  sex        String   @default("other") // female | male | other
  /// The ability tier: basic | beginner | intermediate | advanced | athlete.
  /// Sets TRAINING DAYS PER WEEK and the starting INTENSITY CEILING — see
  /// LEVELS / levelDef() in fitness/fitness-engine.ts. A statement about what
  /// this citizen can safely be asked to do.
  ///
  /// NOT a self-description, and NOT the activity scale. Dating's
  /// `extras.fitnessLevel` ('Sedentary'…'Daily') is how somebody describes
  /// themselves to another citizen and sets nothing; MasterProfile.activityLevel
  /// is the multiplier that decides a calorie target. Three fields, three
  /// questions, and two of the dating values spell the same as two activity
  /// keys — see shared/fitness-level.ts, which refuses to convert between them.
  ///
  /// Defaulted to 'beginner' at registration, so `answeredAt` above is the only
  /// way to tell this apart from an answer.
  level      String   @default("beginner")
  mode       String   @default("mixed") // mixed | strength | walking | running
  goal       String   @default("general") // general | weightLoss | strength | endurance
  conditions String   @default("") // csv: hypertension|diabetes|pregnancy|jointPain
  heightCm   Int?
  weightKg   Int?
  bodyGoal   String   @default("athletic") // buildMuscle | leanDefine | athletic | fatLoss
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id        String   @id @default(uuid())
  userId    String
  focus     String
  minutes   Int
  intensity String   @default("moderate") // light | moderate | vigorous
  note      String?
  doneAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt])
}

// ─────────────────────────── Financial Hub ───────────────────────────
// The unifying city wallet: aggregates spend from every commerce hub
// (Nutrition orders, Beauty orders, Medical consults) into one view.
model CityWallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  balanceInr Int      @default(0)
  cardBrand  String?
  cardLast4  String?
  cardName   String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Mira's meter and her pass. `chatUsed` counts MODEL-BACKED conversations
/// only — the deterministic capabilities, navigation and the greeting are
/// never metered, so the working city stays free. Two hundred conversations
/// are free for life; `paidUntil` is the rolling 30-day subscription that
/// continues them. One row per citizen, created lazily on the first chat.
model MiraPass {
  userId    String    @id
  chatUsed  Int       @default(0)
  paidUntil DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Her memory: both sides of every exchange, per citizen, per room
/// ('friend' | 'city'). This is what lets tomorrow's Mira remember today
/// across devices — and the forget command tears pages out of it, which is
/// the only write she can perform anywhere. Purge-classified; cascades with
/// the account.
model MiraTurn {
  id        String   @id @default(uuid())
  userId    String
  room      String
  who       String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, room, createdAt])
}

model WalletTxn {
  id        String   @id @default(uuid())
  userId    String
  kind      String // topup | payment | refund
  amountInr Int
  hub       String? // Nutrition | Beauty | Medical | Wallet (for payments)
  category  String? // nutrition | beauty | medical
  label     String?
  createdAt DateTime @default(now())

  /// The caller's own name for this attempt, from an `Idempotency-Key` header.
  /// A retry — a double tap, a flaky connection, a PSP webhook delivered twice —
  /// carries the key of the attempt it is repeating, and the unique index below
  /// is what makes the second one credit nothing. NULL for everything that
  /// predates this and for callers that send no key.
  idempotencyKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

/**
 * A LINE IN THE CITIZEN'S OWN SPENDING LOG.
 *
 * Everything else the Financial hub knows about is money the CITY moved: an
 * order it placed, a wallet it debited, a rate it charged. This is the other
 * kind — cash spent in a shop the city has never heard of, written down by the
 * person who spent it.
 *
 * THREE COLUMNS AND NO CATEGORY, and the absence is the design. Asking somebody
 * to file "auto to work, ₹80" under one of seven headings before it will accept
 * the entry is how a log stops being written in. The note is whatever they
 * typed; the total is a number they typed beside it.
 *
 * `spentOn` IS A DATE AND NOT A TIMESTAMP. A citizen logging yesterday's coffee
 * is naming a day, not an instant, and storing an instant would put their entry
 * in the wrong month for five and a half hours a day in Asia/Kolkata — which is
 * the bug the shared clock service exists to prevent everywhere else.
 */
model SpendLogEntry {
  id        String   @id @default(uuid())
  userId    String
  /** The day the money went, as the citizen named it. */
  spentOn   DateTime @db.Date
  /** What they wrote. Free text on purpose — see the note above. */
  note      String
  amountInr Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Read by user and month, always, and never by note.
  @@index([userId, spentOn])
}

model Budget {
  id         String @id @default(uuid())
  userId     String
  category   String // nutrition | beauty | medical
  monthlyInr Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// ─────────────────────────── Jobs Hub ───────────────────────────
// Two-sided: candidates upload a resume → parsed profile → matched roles;
// companies post jobs and see applicants. "Upload once. We do the rest."
model JobProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  headline        String   @default("")
  skills          String   @default("") // csv of skill keys
  experienceYears Int      @default(0)
  seniority       String   @default("junior") // junior | mid | senior | lead
  location        String?
  resumeText      String   @default("")
  resumeName      String?
  /// The FILE, kept as well as the text pulled out of it. Storing only the
  /// extracted text meant a citizen could upload a CV and then never see it
  /// again — the app had read their document and given them nothing back.
  resumeUrl       String?
  resumeBytes     Int      @default(0)
  resumeAt        DateTime?
  /// A face on a job profile. Optional, and never inferred from anywhere else.
  photoUrl        String?
  /// THE PERSON'S NAME, kept as its own field rather than left inside the
  /// headline. The parser used to put whatever the CV's first line said into
  /// the headline — often the name, often "APPLICATION LETTER Applicant: ..."
  /// — so a profile showed a document header where a person should be. A name
  /// and a job title are two different facts and neither is a substitute.
  fullName        String   @default("")
  /// The paragraph a recruiter actually reads. Written by the reader from the
  /// CV and then EDITED BY THE CITIZEN — never published unread, because a
  /// summary of somebody's career is a claim they have to stand behind.
  summary         String   @default("")
  currentTitle    String   @default("")
  currentCompany  String   @default("")
  /// One per line, as typed. A degree list is not worth a table.
  education       String   @default("")
  /// csv of role titles they want to be found for.
  openToRoles     String   @default("")
  noticeDays      Int?
  expectedLpa     Int?
  links           String   @default("")

  /// ── EMPLOYMENT AND AVAILABILITY ──
  /// employed | selfEmployed | freelancer | entrepreneur | student |
  /// betweenRoles | firstJob | retired | other. "" means nobody has asked —
  /// which is different from "other", and the difference matters because the
  /// AI is forbidden from assuming either.
  employmentStatus String @default("")
  /// actively | open | notLooking | unsure. "" = not asked.
  openToOffers     String @default("")
  /// csv: fullTime | partTime | contract | freelance | consulting | internship
  employmentTypes  String @default("")
  /// csv: remote | hybrid | onSite
  workModes        String @default("")
  /// yes | no | maybe | "" (not asked)
  relocate         String @default("")
  /// csv of place names they would work in.
  preferredPlaces  String @default("")

  /// ── COMPENSATION. Private by default, and never inferred from a CV. ──
  /// Minor units are pointless here and a float is worse; these are whole
  /// currency units per year.
  currentFixed    Int?
  currentVariable Int?
  expectedMin     Int?
  currency        String @default("INR")
  /// annual | monthly
  salaryPeriod    String @default("annual")

  /// ── VISIBILITY. Each is: private | recruiters | everyone. ──
  /// The defaults are the promise the app currently prints on /jobs/profile —
  /// "companies can't browse or search you" — so an existing citizen's
  /// exposure does not change when this ships.
  profileVisibility String @default("private")
  contactVisibility String @default("private")
  salaryVisibility  String @default("private")

  /// The order the sections appear in, csv of `kind`. A filmmaker leads with
  /// credits and a doctor with certifications; the visual language does not
  /// change, the running order does. Empty = the default order for whatever
  /// the profile actually contains.
  sectionOrder String @default("")

  /// Bumped on every accepted change, so an upload can be diffed against what
  /// is already here rather than overwriting it.
  revision Int @default(1)

  updatedAt       DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries CvEntry[]
}

/// ─── THE PROFESSIONAL RECORD ───────────────────────────────────────────────
/// One table, not eight.
///
/// A job, a degree, a certificate, a project, an award, a language and a link
/// are the same SHAPE: a thing with a name, somewhere it happened, a span of
/// time, some prose and some tags. Eight tables would be eight migrations,
/// eight DTOs, eight CRUD surfaces and eight editors that drift apart — and it
/// would still not answer the part of the brief that matters most, which is
/// that a filmmaker's profile leads with credits and a doctor's with
/// specialisations. Sections that differ per profession cannot be a fixed set
/// of tables; they have to be data.
///
/// So: one row per entry, `kind` says what it is, `order` says where it sits,
/// and `JobProfile.sectionOrder` says which sections lead. A new section type
/// — filmography, publications, patents, clients — is a new `kind`, not a
/// migration.
///
/// CONFIDENCE IS A COLUMN, not a heuristic re-run at read time. The reader
/// records how sure it was WHEN IT READ, because that is the only moment the
/// evidence exists; a low-confidence row renders as "please confirm" and never
/// as a fact. `source` says who wrote it, so a citizen's own edit is never
/// overwritten by a later upload.
model CvEntry {
  id        String   @id @default(uuid())
  profileId String
  /// experience | education | project | certification | award | language |
  /// link | custom. Open on purpose — see the note above.
  kind      String
  /// Position within its section. Citizens reorder; nothing here is
  /// chronological by accident.
  order     Int      @default(0)
  /// Hidden, not deleted. "I do not want this on my profile" and "this never
  /// happened" are different statements and only one of them is destructive.
  hidden    Boolean  @default(false)

  /// The line a reader sees first: a job title, a degree, a project name.
  title        String  @default("")
  /// The employer, the institution, the issuing body, the client.
  organisation String  @default("")
  /// Employment type, field of study, credential ID, proficiency — the one
  /// qualifier whose meaning depends on `kind`.
  qualifier    String  @default("")
  location     String  @default("")
  /// Kept as WRITTEN, not as a Date. A CV says "2019", "Mar 2019", "Spring
  /// 2019" and "2019–present", and parsing that into a timestamp invents a
  /// day the document never claimed. Sorting uses `startSort`.
  startText    String  @default("")
  endText      String  @default("")
  /// yyyymm as an integer, 0 when unknown. Sortable without pretending to a
  /// precision the source did not have.
  startSort    Int     @default(0)
  current      Boolean @default(false)

  description String @default("")
  /// Responsibilities and achievements, one per line. Not JSON: a list of
  /// sentences is a list of sentences.
  bullets     String @default("")
  /// csv. Skills used, technologies, subjects.
  tags        String @default("")
  url         String @default("")

  /// high | medium | low. Anything below high is shown for confirmation
  /// before it counts as a claim the citizen is making.
  confidence String @default("high")
  /// cv | ai | citizen. A citizen edit is never overwritten by a re-upload.
  source     String @default("citizen")
  /// Where in the document this came from, so "please confirm" can show it.
  evidence   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JobProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, kind, order])
}

model Job {
  id         String   @id @default(uuid())
  postedById String? // null = seeded platform listing
  title      String
  company    String
  location   String
  remote     Boolean  @default(false)
  seniority  String   @default("mid")
  skills     String   @default("") // csv of skill keys
