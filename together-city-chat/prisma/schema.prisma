  quotaBytes BigInt  @default(10737418240) // 10 GB
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An admin role held by one person, granted by another.
///
/// A row rather than a column on User, because WHO GRANTED IT and WHEN are
/// part of the fact. A role that appeared in a column has no author; a role
/// with no author is one nobody can be asked about.
///
/// Revoking sets revokedAt rather than deleting. The history of who could do
/// what, when, is the only way to read an old audit entry correctly.
/// A kill switch for one hub, flipped from the developer page.
///
/// A row exists only once somebody has touched the flag: MISSING MEANS ON. The
/// alternative — seeding every key as enabled — means a failed seed is an
/// outage, and it makes "has anybody ever turned this off" unanswerable.
///
/// `key` is constrained by code, not by the database: FLAGS in
/// src/dev/feature-flags.ts is the fixed list, and nothing else can be written.
/// A CHECK constraint here would have to be migrated every time a hub is added,
/// and would drift from the list the guard actually reads.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  /// Why it was last flipped, in the flipper's words. Shown on the page beside
  /// the switch — "Dating has been off since Tuesday" should never be a mystery.
  note      String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")
}

model AdminGrant {
  id        String    @id @default(uuid())
  userId    String
  role      String
  grantedBy String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  reason    String    @default("")

  user User @relation("adminGrantHolder", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Every admin action that changed something.
///
/// before/after are JSON snapshots of the field that moved, not the whole row:
/// a diff somebody can read beats a dump nobody opens, and a whole-row copy of
/// a citizen's record duplicates their data into a table with different access
/// rules.
///
/// `reason` is required by the API, not by the column. A schema cannot tell an
/// empty string from a considered one; a form that will not submit without a
/// sentence can. The column exists so the sentence has somewhere to live.
model AdminAudit {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  /// What was acted on: "user", "listing", "ticket", "flag".
  entity    String
  entityId  String
  before    String?
  after     String?
  reason    String   @default("")
  ip        String?
  at        DateTime @default(now())

  actor User @relation("adminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([at])
}

model MailMessage {
  id         String   @id @default(uuid())
  ownerId    String // whose mailbox this copy lives in
  boxUserId  String // duplicate of ownerId for indexing clarity
  /// inbox | sent | failed | trash
  ///
  /// `failed` exists because Sent used to mean "we tried". A message the
  /// provider rejected was written to Sent BEFORE dispatch and left there when
  /// dispatch failed, so the sender saw an error and a Sent copy of the same
  /// message (p21). Sent now means accepted; failed means it was not.
  folder     String
  fromAddr   String
  fromName   String
  toAddr     String
  toName     String
  /// Carbon copy — everyone who was openly copied, comma-separated addresses.
  /// Present on every copy, because being on Cc is a fact all recipients share.
  ccAddrs    String?
  /// Blind carbon copy. Written ONLY on the sender's own Sent row. A recipient
  /// copy carrying this column is the leak that makes Bcc pointless, so it is
  /// never written to one — see mail-cc-bcc.spec.ts.
  bccAddrs   String?
  subject    String
  body       String
  snippet    String   @default("")
  sizeBytes  Int      @default(0)
  read       Boolean  @default(false)
  starred    Boolean  @default(false)
  system     Boolean  @default(false)
  threadId   String?
  /// Why the provider would not take it, in the provider's own words. Null on
  /// everything that was accepted, which is every message in Sent.
  failureReason String?
  /// The provider's id for the accepted message, so a bounce webhook can find
  /// this row later (BE-2.2 / BE-14.1).
  providerMessageId String?
  /// JSON array of Drive file ids, kept ONLY on a failed row so Retry can send
  /// the same message with the same files. Without it a retry quietly went out
  /// without the attachments — the message looked sent and arrived incomplete.
  attachmentIds     String?
  /// The project this message's THREAD is filed under, or null for All Email.
  ///
  /// Denormalised onto every row of the thread rather than held in a join
  /// table, because the only query that reads it is the folder list — one
  /// indexed read per screen — and a join would put a growing `IN (…)` in
  /// front of every mailbox. The invariant that makes it safe is that
  /// `fileThread()` is the ONLY writer and moves every row of a thread at
  /// once: half a conversation in a project is the bug this column could
  /// otherwise have.
  ///
  /// Per-mailbox, always. A recipient's copy is never stamped with the
  /// sender's project — the filing is one citizen's, not the message's.
  projectId         String?
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, folder, createdAt])
  @@index([ownerId, projectId, folder, createdAt])
}

/// A ROOM INSIDE ONE CITIZEN'S MAILBOX.
///
/// A project files THREADS. It never hides a message from All Email — the
/// scoped mailbox is a view of the same rows — and deleting one clears the
/// filing rather than the mail.
model MailProject {
  id         String   @id @default(uuid())
  ownerId    String
  name       String
  /// Lowercase slug, unique per mailbox because it is both the URL
  /// (/mail/p/<key>) and the optional sub-address (you+<key>@togethercity.app).
  key        String
  /// ON BY DEFAULT: every project has an id, and the id is the mailbox's own
  /// address with the project's key on it. Outbound mail from the project is
  /// sent Reply-To that address, so a reply files itself here even when the
  /// thread cannot be matched — a different client, a rewritten subject, a
  /// forward that comes back. It grants nothing: mail to you+<key>@ lands in
  /// YOUR mailbox exactly as mail to you@ does; the tag only says which room.
  subAddress Boolean  @default(true)
  /// One of the nine folder tints, or 'slate'. A plain string rather than an
  /// enum: adding a tenth colour should be a token and a list in the client,
  /// not a migration, and the client already falls back to slate on anything
  /// it does not recognise.
  color      String   @default("blue")
  /// The line under the name on the folder — what this project is FOR, in the
  /// citizen's own words. Optional: a project with no description shows what
  /// is in it instead, which is the more useful sentence once there is any.
  description String?
  /// A finished project: out of the rail, filing kept, accepting nothing new.
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, key])
  @@index([ownerId, archived, createdAt])
}

// Outbound delivery log — every message dispatched OUTSIDE the city (email or SMS)
// through the pluggable messaging provider. This is the receipt/notification ledger.
model EmailDelivery {
  id                String   @id @default(uuid())
  userId            String
  channel           String   @default("email") // email | sms
  toEmail           String? // set for channel=email
  toPhone           String? // set for channel=sms
  kind              String // receipt | recovery | security | welcome
  subject           String
  body              String
  provider          String   @default("stub") // stub | sendgrid | ses | smtp | twilio | ...
  providerMessageId String? // id returned by the provider (audit trail)
  status            String   @default("sent") // queued | sent | failed
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  /// argon2 hash of the 6-digit code — never the code itself. A leaked backup
  /// or a stray query result must not be enough to take over an account.
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong guesses against this code. A 6-digit code is 1e6 wide, which is
  /// brute-forceable without a ceiling; the code is burned at MAX_RESET_ATTEMPTS.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email-verification (and future purpose-scoped) tokens. The raw token is sent
// in the link; only its sha256 is stored so it's lookup-able but not reversible.
/// A 6-digit code proving control of one email address or one phone number.
///
/// Separate from VerificationToken (the 24-hour email link) rather than folded
/// into it: a link and a code have different lifetimes, different brute-force
/// exposure and different failure messages, and the one thing they share — a
/// hash column — is not enough to justify a table that means two things.
///
/// The code itself is never stored. `codeHash` is an argon2 hash, the same
/// treatment a password gets, because a six-digit secret in a leaked backup is
/// worth exactly as much as the account it unlocks.
/// Who changed what, when — the audit trail for health data (§3 BE-3.1).
///
/// One row per FIELD, not per request: the question is "when did my weight
/// change and where did it come from", not "what did that request contain".
model ProfileChange {
  id          String   @id @default(uuid())
  userId      String
  field       String
  oldValue    String?
  newValue    String?
  /// The surface that wrote it — 'master-profile-page', 'nutrition', 'dating'…
  source      String
  /// Normally the citizen. Different when a household owner edits a dependent's
  /// record (§12); the column exists before that can happen so the history is
  /// answerable from day one.
  changedById String?
  changedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([userId, field, changedAt])
}

model VerificationCode {
  id         String    @id @default(uuid())
  userId     String
  /// "email" | "phone"
  channel    String
  /// The normalised address or E.164 number this code was sent to. Stored so a
  /// code issued for one address cannot verify a different one after an edit.
  target     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  /// Requesting IP, for the per-connection send cap. Not shown to anyone.
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The send-throttle query: "codes issued to this target in the last hour".
  @@index([target, createdAt])
  /// The verify query: "the newest live code for this user on this channel".
  @@index([userId, channel, createdAt])
  /// The per-IP cap.
  @@index([ip, createdAt])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256(rawToken)
  purpose   String    @default("email_verification")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Account-recovery OTP (production forgot-password flow). The OTP is stored
// HASHED (argon2), carried by an opaque recoveryToken (never the identifier),
// with attempt/resend limits, a lockout window, and IP/device for the audit log.
model RecoveryCode {
  id          String    @id @default(uuid())
  userId      String
  otpHash     String // argon2 hash of the 6-digit code — never the code itself
  token       String    @unique // opaque handle returned to the client (request stage)
  resetToken  String?   @unique // issued after successful OTP verification (reset stage)
  purpose     String    @default("password_recovery")
  channel     String    @default("email") // email | sms
  expiresAt   DateTime
  attempts    Int       @default(0)
  resends     Int       @default(0)
  lockedUntil DateTime?
  verifiedAt  DateTime?
  usedAt      DateTime?
  ipAddress   String?
  device      String? // user-agent fingerprint
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────── Platform master data (reusable lookups) ───────────────────────
// One generic table powering every standardized dropdown across Together City
// (countries, states, cities, languages, religions, …). New dropdown types need
// no schema change — just a new `category`. Hierarchy (country→state→city) is
// expressed via `parentCode` referencing the parent row's `code` in its category.
model Lookup {
  id         String  @id @default(uuid())
  category   String // 'country' | 'state' | 'city' | 'language' | 'religion' | …
  code       String // stable code, unique within its category
  label      String // human display value
  parentCode String? // parent row's code (e.g. a city's state, a state's country)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@unique([category, code])
  @@index([category, parentCode])
  @@index([category, label])
}

// ─────────────────────── Astrology Zone ───────────────────────
// One shared birth-details profile powering every feature that reads a chart
// (Astrology Zone, Dating matchmaking, compatibility, future features). If the
// user already entered birth details elsewhere (dating onboarding), the service
// auto-seeds this profile so nothing is asked twice.
model AstroProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  birthDate    DateTime
  birthTime    String? // "HH:MM" local at birth place · null = time unknown (Sun-sign chart)
  birthCountry String
  birthState   String?
  birthCity    String
  timeZone     String // IANA, auto-detected client-side, editable
  lat          Float? // resolved from city lookup (approximate is fine)
  lng          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // How many consultations this citizen has ever been given. A COUNTER, not a
  // count: five are free and the sixth opens a ₹100 set of five, and
  // consultations are deletable, so an allowance derived from AstroQuestion
  // rows could be reset by deleting them. This only ever goes up.
  questionsAsked Int @default(0)

  /// The gem cart — a JSON array of CONFIGURATIONS, never of prices.
  ///
  /// A commission is the stone plus the cut, the mount, the metal, the size and
  /// the grade; columns for those would be a migration per design decision. The
  /// rate, the weight model and the making charge live in one server file, so a
  /// cart that carried totals could check out at a number the shop no longer
  /// offers. Null means never opened the studio, which is not the same as an
  /// empty cart.
  gemCartJson String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// "Ask the Astrologer" consultations — five free per citizen, then ₹100 for the
// next five. Every question and its full answer is kept until the citizen
// deletes it, which does not return the consultation to their allowance.
model AstroQuestion {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  question  String
  answer    String
  priceInr  Int      @default(0) // what this one actually cost, kept as a record
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One saved reading per user per period — daily rows keyed by the user's LOCAL
// calendar day (their midnight starts a new one), monthly rows keyed by month
// (fixed from the 1st). The composers are deterministic, so the stored reading
// is exactly what a midnight/1st-of-month batch job would have produced —
// persisted on first touch of the new period and archived on the profile.
model AstroReading {
  id          String   @id @default(uuid())
  userId      String
  kind        String // 'daily' | 'monthly'
  period      String // daily: YYYY-MM-DD (user tz) · monthly: YYYY-MM
  readingJson String // full reading payload
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, kind, createdAt])
}

/// A tarot draw. `seed` is what makes a reading REPRODUCIBLE — the same seed
/// always deals the same cards in the same order and orientation, so a reading
/// can be regenerated and checked long after the fact. Without it a "random"
/// draw is unverifiable.
model TarotReading {
  id          String   @id @default(uuid())
  userId      String
  kind        String // 'daily' | 'three' | 'celtic'
  /// Set for the free daily card (YYYY-MM-DD in the citizen's own timezone) so
  /// one card stands for the whole day. NULL for paid spreads — Postgres treats
  /// NULLs as distinct, so a citizen may draw as many spreads as they pay for.
  period      String?
  question    String?
  seed        String
  readingJson String
  priceInr    Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, createdAt])
}

// ─────────────────────── Master Profile ───────────────────────
// THE single source of truth for shared user information. Every hub reads
// from it (auto-populate) and writes shared fields back through
// MasterProfileService.syncShared(), which also propagates the values into
// the hub tables that historically duplicated them (astro, dating, food,
// fitness) so every engine keeps working while never diverging again.
model MasterProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  /// SUPERSEDED by sexAtBirth + genderIdentity. Kept as the read fallback for
  /// rows the 20260730200000 backfill did not reach; no longer written.
  gender       String? // male | female | nonbinary | other
  /// Clinical only — BMR, reference intakes, lab ranges. Never shown to another
  /// citizen. male | female | intersex | preferNotToSay
  sexAtBirth   String?
  /// Social only — how the app refers to them, what dating shows. Never enters
  /// a formula. male | female | nonBinary | other
  genderIdentity      String?
  /// Free text, used when genderIdentity is "other".
  genderIdentityOther String?
  /// Bumped on every write. A client may send its expected version and be told
  /// the profile moved under it, instead of silently overwriting.
  version      Int       @default(0)
  dateOfBirth  DateTime?
  timeOfBirth  String? // HH:MM · null = unknown
  birthCountry String?
  birthState   String?
  birthCity    String?
  country      String? // current location
  state        String?
  city         String?
  timeZone     String?
  languages    String? // csv
  heightCm     Int?
  weightKg     Int?
  occupation   String?
  phone        String?
  /// Where deliveries go — and NO WRITER TODAY (B.18). It was collected at the
  /// grocery checkout, for a delivery that does not happen; the checkout now
  /// stops at the shopping list and asks for nothing. Existing values are the
  /// citizens' own answers and are left alone. The hub that starts delivering
  /// is the one that earns the right to ask again.
  address      String?
  /// Declared food allergens, csv, as the citizen wrote them (canonicalised by
  /// declaredTerm() — "nut allergy" is stored as "nut").
  ///
  /// THE CITIZEN'S WORDS, NOT OUR KEYS. Storing the resolved AllergenKey set
  /// would be tidier and would silently drop every allergen our families do not
  /// know — kiwi, mango, a brand of stabiliser — which is exactly the set where
  /// being wrong is least recoverable. Consumers run this through findAllergen(),
  /// which does the family expansion at match time and honours an unknown term
  /// literally on whole words.
  ///
  /// Written by Nutrition, where it is asked. Read by Beauty and Restaurants,
  /// which never ask. NOT rendered into any hub's editable form — a second
  /// editable copy is the problem §3 exists to remove.
  foodAllergens String?
  /// Single | inRelationship | engaged | married | separated | divorced |
  /// widowed | preferNotToSay. NULL means nobody has asked or they skipped it;
  /// 'preferNotToSay' means they were asked and declined, which is a different
  /// fact and reads differently on screen.
  ///
  /// NOT dating's relationshipGoal (what they are looking for) and NOT
  /// Connection.relationship (their relationship to another person). Three
  /// different questions; see shared/relationship-status.ts. Nothing computes
  /// with this one — the profile shows it back, and that is all it does.
  relationshipStatus String?
  /// The citizen's blood group — one of the eight ABO/Rh groups, 'hh+'/'hh-'
  /// for the Bombay phenotype (ABO-independent, but Rh still applies, which is
  /// why it carries a sign), or the string 'unknown' meaning they answered and
  /// do not know it. NULL means nobody has asked or they skipped it, which is a
  /// DIFFERENT fact and reads differently on screen.
  ///
  /// Optional by design, and nothing computes with it: no target, no filter, no
  /// recommendation. The Medical hub shows it back to its owner, which is the
  /// whole of its job. Never derived - not from a parsed lab report, not from a
  /// family member.
  bloodGroup String?
  /// What the citizen eats, as a Nutrition key: everything | veg | nonveg |
  /// pesc | egg | vegan | jain. shared/diet.ts is the only crossing point to
  /// the label the dating form stores, and names what that crossing loses.
  ///
  /// WRITE-OWNER: NUTRITION. The meal engine branches on this, so the value
  /// that decides what somebody is served has one writer. Dating fills it only
  /// when nothing else has (gap consolidation), and never overwrites it.
  ///
  /// NEVER DEFAULTED. FoodPref.diet defaults to 'everything' at registration
  /// and that default reads exactly like an answer — so this column stays NULL
  /// until somebody actually answers. A diet is a rule about what may be put in
  /// front of a person, not a preference to be assumed.
  dietaryPreference String?
  /// How much the citizen moves, in the five named levels of shared/energy.ts —
  /// sedentary | light | moderate | active | veryActive.
  ///
  /// The LEVEL, not the multiplier. A number in a profile column is a number
  /// somebody will invent a new scale for; the name is the thing the citizen
  /// actually answered, and every engine looks the factor up from one table.
  activityLevel String?
  /// What the citizen declares about their own health, as csv keys from
  /// shared/health-conditions.ts in that file's order. NULL means nobody has
  /// asked. The literal 'none' means they were asked and ticked nothing, which
  /// is an ANSWER — the same distinction bloodGroup draws with 'unknown', and
  /// never the empty string, which mergeShared() reads as a gap to be filled.
  ///
  /// **Write-owner: the citizen, on the Master Profile page.** Nutrition,
  /// Fitness, Medical and Beauty each still read their own list today; this is
  /// the column they converge onto, and until they do nothing here is copied
  /// into them — a second editable copy is the defect, not the migration path.
  ///
  /// Blood-DERIVED conclusions never land here. 'glycemic', 'dyslipidemia',
  /// 'inflammation' and 'anemia' are things a lab report says, not things a
  /// citizen declared, and shared/health-conditions.ts refuses them on purpose.
  healthConditions   String?
  /// Pregnancy's qualifier: first | second | third | unstated. NULL means not
  /// answered; 'unstated' means answered and would rather not say, which the
  /// energy figure reads as the second trimester and SAYS SO on screen.
  /// Cleared whenever pregnancy is not among the declared conditions — see
  /// profile/master-health-conditions.ts, which is the only writer.
  pregnancyTrimester String?
  /// Kidney's qualifier: early | late | dialysis | unstated. Three different
  /// protein ceilings; 'unstated' maps to ckdEarly exactly as absent condition
  /// text does today. Cleared whenever kidney is not declared.
  kidneyStage        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// In-app notification feed (social likes/comments/follows, connection
/// requests/accepts, etc.). No User relation by design — kept as a lightweight
/// append-only log keyed by recipient userId, so it never blocks a User write.
model Notification {
  id        String   @id @default(uuid())
  userId    String // recipient
  kind      String // like | comment | follow | connection_request | connection_accepted | post_live | mention
  title     String
  body      String?
  href      String?
  actorId   String? // who triggered it
  entityId  String? // post / comment / connection id
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// ─────────────────────────── User Drive ───────────────────────────
/// A citizen's private online drive: folders + files stored in the SAME
/// private vault as mail and health documents, so one account has ONE 10 GB
/// allowance across everything. Files live in object storage under
/// `drive/<userId>/…`; these rows are the metadata/ownership record.
model DriveFolder {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  parentId  String? // null = drive root
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   DriveFolder?  @relation("DriveFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DriveFolder[] @relation("DriveFolderTree")
  files    DriveFile[]

  @@index([ownerId, parentId])
}

model DriveFile {
  id         String   @id @default(uuid())
  ownerId    String
  folderId   String? // null = drive root
  name       String
  mimeType   String?
  sizeBytes  Int      @default(0)
  storageKey String   @unique // drive/<ownerId>/<uuid>.<ext>
  checksum   String?
  /// What this file is attached to, if anything (e.g. "message", "listing").
  attachedType String?
  attachedId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner  User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ownerId, folderId])
  @@index([attachedType, attachedId])
}


/// ────────────────────── Prescriptions & medicines ──────────────────────
/// A handwritten prescription becomes a digital one, and a confirmed digital
/// one becomes alarms that fire five minutes before each dose.
///
/// The chain is deliberately four tables rather than one. What a doctor wrote
/// (Prescription/PrescriptionItem) is a document and never changes after the
/// citizen confirms it; what they are actually meant to take and when
/// (Medicine/MedicineSchedule) is editable and outlives the paper it came from;
/// and what happened at each dose (MedicineReminder/DoseLog) is an append-only
/// record. Collapsing them would mean editing a schedule rewrites history.

/// An uploaded or hand-entered prescription, plus whatever extraction made of it.
model Prescription {
  id            String    @id @default(uuid())
  userId        String
  /// upload | manual
  source        String    @default("upload")
  /// processing | review_required | confirmed | failed
  ///
  /// review_required is the honest default for anything read off handwriting.
  /// A prescription is never allowed to become a schedule until a human has
  /// looked at it, because a misread dosage is the one error here that hurts.
  status        String    @default("processing")
  fileKey       String?
  fileUrl       String?
  mimeType      String?
  providerJobId String?
  /// The extractor's raw response, kept verbatim so a bad read can be audited
  /// against what the provider actually returned.
  rawExtraction String?
  error         String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PrescriptionItem[]

  @@index([userId, createdAt])
}

/// One medicine line as extracted, with per-field confidence.
model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String?
  frequency      String?
  durationDays   Int?
  instructions   String?
  /// JSON array of "HH:MM" local times this line implies.
  timesLocal     String?
  /// JSON map of field → 0..1. Anything under the review threshold, or missing
  /// altogether, forces needsReview.
  confidence     String?
  needsReview    Boolean  @default(true)
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

/// A medicine this citizen actually takes. Survives the prescription it came from.
model Medicine {
  id        String   @id @default(uuid())
  userId    String
  name      String
  form      String?
  strength  String?
  notes     String?
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules MedicineSchedule[]

  @@index([userId, name])
}

/// When to take it. Times are LOCAL wall-clock plus the zone they were set in,
/// never UTC instants — "08:00 every day" has to stay 08:00 across a DST change,
/// which a stored instant cannot do.
model MedicineSchedule {
  id                 String    @id @default(uuid())
  userId             String
  medicineId         String
  prescriptionItemId String?
  /// JSON array of "HH:MM" in `timezone`.
  timesLocal         String
  /// JSON array of weekday numbers (0=Sunday). Null means every day.
  daysOfWeek         String?
  /// Date-only (midnight UTC), meaning a calendar day in `timezone`.
  startDate          DateTime
  endDate            DateTime?
  timezone           String
  dosage             String?
  instructions       String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine  Medicine           @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  reminders MedicineReminder[]
  doseLogs  DoseLog[]

  @@index([userId, active])
  @@index([medicineId])
}

/// One expanded, dispatchable alarm. The unique key on (schedule, dose instant)
/// is what makes the every-minute dispatcher safe to run twice.
model MedicineReminder {
  id             String    @id @default(uuid())
  scheduleId     String
  userId         String
  scheduledAtUtc DateTime
  /// Always scheduledAtUtc minus five minutes.
  notifyAtUtc    DateTime
  /// pending | sent | failed
  status         String    @default("pending")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  schedule MedicineSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledAtUtc])
  @@index([status, notifyAtUtc])
  @@index([userId])
}

/// What happened at a dose. One row per dose, ever — a double "mark taken"
/// updates rather than appends.
model DoseLog {
  id             String    @id @default(uuid())
  scheduleId     String
  userId         String
  scheduledAtUtc DateTime
  /// taken | skipped | missed
  action         String
  actedAtUtc     DateTime?
  dosageTaken    String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedule MedicineSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledAtUtc])
  @@index([userId, scheduledAtUtc])
}

/// ────────────────────────────── Thoughts ──────────────────────────────
/// A private journal. Not a post: nothing here reaches the social feed, no one
/// else can read it, and it has no likes, comments or audience. The only thing
/// it shares with a Post is that a person wrote it down.
model Thought {
  id     String  @id @default(uuid())
  userId String
  title  String?
  body   String
  /// A single word the citizen picks for how they felt. Free text on purpose —
  /// a fixed list of moods tells people which feelings are allowed.
  mood   String?
  /// Comma-separated, matching how interests and diet tags are stored elsewhere
  /// in this schema rather than introducing a second convention.
  tags   String?
  /// private — the only value today. The column exists so that sharing, if it is
  /// ever built, is a migration of data rather than of meaning.
  visibility String @default("private")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: a deleted thought leaves the citizen's lists immediately and
  /// stays recoverable, because "I deleted the wrong one" is a thing people say
  /// about a journal more than about almost anything else.
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, deletedAt])
}

/// ───────────────────── Makeup reference decode ─────────────────────
/// A photo of a look somebody wants, turned into steps they can follow.
/// The photo is theirs and private; only the derived analysis is kept once
/// the image has been read.
model LookAnalysis {
  id       String @id @default(uuid())
  userId   String
  /// Object key in the private vault. Cleared when the citizen deletes the photo.
  fileKey  String?
  mimeType String?
  /// processing | ready | failed
  status   String @default("processing")
  /// Whether a real vision model read it, or the deterministic reader did.
  readBy   String @default("fallback")
  /// JSON — what the look appears to be: finish, intensity, palette, focus.
  attributes String?
  /// JSON — ordered steps to recreate it.
  steps      String?
  /// JSON — product ids from the beauty shelf matched to those steps.
  productMatches String?
  confidence Float   @default(0)
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// ──────────────────────────── Avatars ────────────────────────────
model Avatar {
  id            String  @id @default(uuid())
  userId        String
  /// JSON of the inputs the citizen chose, so a result can be reproduced.
  inputs        String
  /// queued | ready | failed
  status        String  @default("queued")
  providerJobId String?
  /// Object key of the generated asset in the private vault.
  assetKey      String?
  /// Exactly one avatar per citizen may be selected.
  isSelected    Boolean @default(false)
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isSelected])
}

/// ───────────────────────────── Calls ─────────────────────────────
/// A call belongs to a conversation: who may join is decided by chat
/// membership, never by holding the call id.
model CallSession {
  id             String    @id @default(uuid())
  conversationId String
  createdById    String
  /// audio | video | avatar
  type           String    @default("audio")
  /// ringing | active | ended
  status         String    @default("ringing")
  /// Set when an avatar call is bound to a generated avatar.
  avatarId       String?
  startedAt      DateTime?
  endedAt        DateTime?
  /// Why it ended: completed | declined | missed | cancelled
  endedReason    String?
  createdAt      DateTime  @default(now())

  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([conversationId, createdAt])
  @@index([status])
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  userId   String
  joinedAt DateTime?
  leftAt   DateTime?
  /// caller | callee
  role     String    @default("callee")

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
}

// ───────────────────── Local Services Hub ─────────────────────
// A citizen's own business, advertised by category and by where it works.
// Nothing here is seeded: every row is somebody who chose to list themselves,
// which is why an empty directory is the honest first state rather than a bug.
model ServiceListing {
  id           String   @id @default(uuid())
  ownerId      String
  businessName String
  categoryKey  String // one of the keys in local-services/categories.ts
  about        String? // what they do, in their words
  city         String
  areas        String   @default("") // csv of localities served — the "local" in Local Services
  // WHERE IT ACTUALLY IS. A city and a list of locality names is how a person
  // describes where they work; it is not something a map can draw or a
  // "within 2 km" filter can answer. Nullable because a listing made before
  // this existed has no coordinates and must not become invisible — the
  // directory falls back to city and areas for those.
  lat          Float?
  lng          Float?
  // How far they will travel. Null means "they did not say", which reads
  // differently from 0 and must keep reading differently.
  radiusKm     Int?
  /// Returned to a browser ONLY when phonePublic is true. The owner typed this
  /// under "only you ever see this", so it stays private until they say
  /// otherwise — a number republished by a migration is a broken promise.
  /// The business's own address: /services/anna-idli. Nullable because every
  /// listing made before slugs existed has none and is still reachable by id.
  /// The schema key that generates this listing's form, page and card.
  /// See business-types.ts — the answers live in detailsJson under the field
  /// keys that file declares, so a new trade is a new entry there and never a
  /// migration here.
  businessType String?
  detailsJson  String?
  slug         String?  @unique
  phone        String?
  phonePublic  Boolean  @default(false)
  priceFrom    Int? // ₹, optional — "from" and not a quote
  photosJson   String   @default("[]") // JSON [{url,caption?}]
  moderation   String   @default("approved") // approved | pending | rejected | removed
  moderationJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  enquiries ServiceEnquiry[]
  regulars  ServiceRegular[]
  offers    ServiceOffer[]
  reviews   ServiceReview[]
  menu      ServiceMenuItem[]
  menuScanUrl String? // the photograph the menu was read from — kept so a
                      // citizen can check the transcription against the original

  @@index([moderation, city])
  @@index([categoryKey, city])
  @@index([ownerId])
}

// The thread between somebody looking and somebody offering.
//
// IT IS NOT A Conversation. Reusing the chat hub's model would have put these
// in /chats beside the citizen's real conversations and carried their name into
// a room where the whole point is that it does not go. A separate pair of
// tables is what "anonymous, and only inside this hub" actually costs.
//
// `alias` is minted once per (seeker, listing) and is the only name the
// business ever sees. It is stored rather than derived so the same person is
// recognisably the same person across a conversation, and so a rename of the
// scheme does not rewrite history.
model ServiceEnquiry {
  id            String   @id @default(uuid())
  listingId     String
  seekerId      String
  alias         String // e.g. "Neighbour 4821" — the business sees this and nothing else
  lastMessageAt DateTime @default(now())
  seekerUnread  Int      @default(0)
  ownerUnread   Int      @default(0)
  closed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  listing  ServiceListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seeker   User             @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  messages ServiceMessage[]

  @@unique([listingId, seekerId]) // one thread per person per business, forever
  @@index([seekerId, lastMessageAt])
  @@index([listingId, lastMessageAt])
}

// SOMEBODY'S OWN SHORTLIST.
//
// A citizen who has found their plumber does not want to find them again. This
// is the private list of the businesses they keep going back to — a personal
// marketplace assembled out of the public directory, and visible only to them.
// The business is never told: being saved is not a relationship, it is a
// bookmark, and telling a shopkeeper who has bookmarked them would turn one
// into the other.
model ServiceRegular {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  note      String? // "the one who actually turns up" — their words, for their eyes
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId]) // saving twice is still saved once
  @@index([userId, createdAt])
}

// WHAT A BUSINESS IS OFFERING TODAY.
//
// Dated rather than a flag, because "today's offer" that nobody remembers to
// take down becomes last month's offer with today's date on it — and a
// directory full of stale discounts is worse than one with none. An offer
// carries the days it runs and disappears on its own.
model ServiceOffer {
  id        String   @id @default(uuid())
  listingId String
  title     String
  detail    String?
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now())

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([startsOn, endsOn])
  @@index([listingId, endsOn])
}

// A REVIEW YOU HAD TO EARN, UNDER THE NAME THEY ALREADY KNOW YOU BY.
//
// Two rules, and they are the whole design.
//
// EARNED: a review requires an existing enquiry thread with that business. The
// thread is the only proof of contact this hub has, and it is a real one — you
// cannot review a plumber you never spoke to. It is not proof the work was
// done, and nothing here pretends otherwise.
//
// PSEUDONYMOUS: the review is signed with the SAME alias the business already
// sees in the conversation — "Neighbour 3". So a shopkeeper can connect the
// review to the exchange they remember and answer it, without ever learning who
// wrote it. The alias is copied onto the row rather than joined, because a
// thread can be deleted and a review must not lose its signature when it is.
//
// One review per person per business, editable. A rating is a current opinion,
// not a log of every opinion somebody has ever held.
model ServiceReview {
  id         String   @id @default(uuid())
  listingId  String
  reviewerId String
  alias      String
  rating     Int // 1..5
  body       String?
  ownerReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing  ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([listingId, reviewerId])
  @@index([listingId, createdAt])
}

// A MENU THAT WAS READ OFF A PHOTOGRAPH AND THEN CORRECTED BY A HUMAN.
//
// The AI's output is a DRAFT and never reaches this table on its own. Prices are
// the thing people act on, and a model that misreads ₹180 as ₹160 has produced
// a number the business will be held to. So extraction proposes, the owner
// disposes, and only what they confirmed is stored.
//
// The scan itself is kept on the listing (menuScanUrl) so anyone can check the
// typed menu against the photograph it came from.
model ServiceMenuItem {
  id          String   @id @default(uuid())
  listingId   String
  section     String? // "Starters", "South Indian" — the menu's own headings
  name        String
  description String?
  // Paise-free rupees. Null is "ask" rather than free — a menu that prints
  // "seasonal" must not become ₹0 on a card.
  priceInr    Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model ServiceMessage {
  id         String   @id @default(uuid())
  enquiryId  String
  // 'seeker' | 'owner'. A SIDE, not a user id — the row itself must not be able
  // to tell the business who wrote it.
  senderSide String
  body       String
  createdAt  DateTime @default(now())

  enquiry ServiceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
}

/// THE DAYBOOK — a day as the person who lived it recorded it.
///
/// The calendar was a grid with nothing behind it: every hub's bookings were
/// meant to flow into it and none ever did, so it rendered an empty month and
/// called itself a Master Calendar. This is the other half of the idea, and
/// the half that could not be borrowed from anywhere else — the day as the
/// citizen keeps it rather than as the city scheduled it.
///
/// THE DATE IS A STRING, DELIBERATELY. A day is something people live in
/// their own timezone; an instant stored in UTC and read back in another zone
/// silently becomes the day before, which for a diary is not a rounding error
/// but the wrong page. YYYY-MM-DD is the day they meant, everywhere.
model DayPage {
  id     String @id @default(uuid())
  userId String
  /// YYYY-MM-DD, in the citizen's own calendar.
  date   String
  /// One word for how the day felt, from a list they can ignore — free text,
  /// for the reason Thought.mood is free text: a fixed list of moods tells
  /// people which feelings are allowed.
  mood     String?
  /// What is behind the mood, in their words.
  feelNote String?
  /// The day's page. Private, always — there is no visibility column here
  /// because there is no version of this that is shared.
  journal  String?
  /// THE LOOKING-BACK SHEET, from the owner's reference (15 Aug): what went
  /// well, what they are proud of, three things they are grateful for, what
  /// was difficult, what it taught them, the win, the challenge, tomorrow's
  /// focus, and a 1–10 reading of the day.
  ///
  /// ONE JSON COLUMN RATHER THAN ELEVEN, because it is a TEMPLATE and the one
  /// certain thing about a template is that its prompts change. The keys are
  /// named and validated in the controller — this is not a bucket a client can
  /// fill with whatever it likes — but rewording, adding or retiring a prompt
  /// costs a line instead of a migration, and a product that must migrate to
  /// reword a question stops rewording its questions.
  reflection Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// One line on a day's page: a task, a meeting, a reminder, an appointment.
/// The kind is a string rather than an enum because the list will grow (an
/// alarm, a habit, a hub booking flowing in) and a migration per new kind is
/// how a product stops adding them.
model DayItem {
  id     String @id @default(uuid())
  userId String
  date   String
  kind   String  @default("task")
  title  String
  /// HH:MM in their own clock, when the thing has a time. Absent is not a
  /// missing value — most of what people mean to do has no hour.
  at     String?
  done   Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// A photograph kept on a day. "Let people attach pictures for the day if they
/// want to save a memory" — the owner, 15 Aug.
///
/// THERE IS NO URL COLUMN HERE, AND THAT IS THE DESIGN. Everything else in the
/// city that stores a picture wants it public — a post, a listing, a menu — so
/// it keeps a `fileUrl` into the public bucket. A photograph somebody put in
/// their diary is the opposite: it goes to the PRIVATE vault under
/// `daybook/<userId>/`, and the only way to see it is a short-lived signed link
/// the API issues to the one account it belongs to. A URL column would be a
/// permanent public address for the most private image in the application.
model DayPhoto {
  id     String @id @default(uuid())
  userId String
  /// YYYY-MM-DD — the day it belongs to, not the day it was uploaded.
  date   String
  /// The object key in the private vault. Ownership is provable from the key
  /// itself (`daybook/<userId>/…`), which is what stops a key handed in by a
  /// client from filing somebody else's object as this citizen's memory.
  fileKey   String
  mimeType  String?
  sizeBytes Int     @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
