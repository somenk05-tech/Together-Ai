// Together City — Chat schema
// Connection-gated messaging: a message may only exist between users who share
// an ACCEPTED Connection. Enforced in application layer (ConnectionPermissionService)
// and reinforced by conversation membership.

generator client {
  // Prisma 7: driver adapters and the query compiler are standard — no preview flags needed.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL no longer lives here. The CLI (migrate/db push)
  // reads it from prisma.config.ts; the app passes it via the pg driver adapter
  // in PrismaService. Both use the DATABASE_URL environment variable.
}

// ─────────────────────────── enums ───────────────────────────
enum ConnectionType {
  FRIEND
  COUPLE
  FAMILY
  BUSINESS_CUSTOMER
  DOCTOR_PATIENT
  NUTRITIONIST_CLIENT
  LAWYER_CLIENT
  MARKETPLACE_BUYER_SELLER
  EVENT_PARTICIPANT
  // Extend here — add a value + a rule in connection-permission.rules.ts
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
  REMOVED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  LOCATION
  CONTACT
  STICKER
  GIF
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
}

// ─────────────────────────── models ──────────────────────────
model User {
  id           String   @id @default(uuid())
  handle       String   @unique
  name         String
  email           String? // primary (external) email — from sign-up; receipts & recovery go here
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phone        String? // primary phone
  profileImage String?
  bio          String? // short public profile bio
  city         String? // public home city shown on the social profile
  website      String? // optional public link
  passwordHash String
  watchlistJson String? // Entertainment Watchlist — JSON array of saved movies/series
  lastSeen     DateTime @default(now())
  onlineStatus Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectionsInitiated Connection[]         @relation("ConnectionUserOne")
  connectionsReceived  Connection[]         @relation("ConnectionUserTwo")
  memberships          ConversationMember[]
  messages             Message[]            @relation("MessageSender")
  messageStatuses      MessageStatus[]
  refreshTokens        RefreshToken[]
  deviceTokens         DeviceToken[]

  foodPref             FoodPref?
  mealPlans            MealPlan[]
  calorieEntries       CalorieEntry[]
  groceryCarts         GroceryCart[]
  walletLedger         WalletLedger[]
  nutritionOrders      NutritionOrder[]
  bloodMarkers         BloodMarker[]
  medicalBloodTests    MedicalBloodTest[]
  medicalRecords       MedicalRecord[]
  doctorProfile        Doctor?
  consults             Consult[]
  medicalConsents      MedicalConsent[]
  beautyProfile        BeautyProfile?
  beautyOrders         BeautyOrder[]
  fitnessProfile       FitnessProfile?
  workoutLogs          WorkoutLog[]
  cityWallet           CityWallet?
  walletTxns           WalletTxn[]
  budgets              Budget[]
  jobProfile           JobProfile?
  jobsPosted           Job[]
  jobApplications      JobApplication[]
  properties           Property[]
  ticketBookings       TicketBooking[]
  tripBookings         TripBooking[]
  diningOrders         DiningOrder[]
  reservations         Reservation[]
  mailAccount          MailAccount?
  mailMessages         MailMessage[]
  emailDeliveries      EmailDelivery[]
  passwordResets       PasswordReset[]
  dietitianProfile     Dietitian?
  dietitianBookings    DietitianBooking[]

  posts                Post[]
  postComments         Comment[]
  postLikes            Like[]
  following            Follow[]             @relation("FollowFollower")
  followers            Follow[]             @relation("FollowFollowee")
  datingProfile        DatingProfile?
  datingMatchesOne     DatingMatch[]        @relation("DatingUserOne")
  datingMatchesTwo     DatingMatch[]        @relation("DatingUserTwo")

  @@index([onlineStatus])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  device     String? // user-agent fingerprint, for the "active sessions" list
  ip         String? // last-seen IP (coarse), for session review
  lastUsedAt DateTime @default(now()) // updated on each silent refresh
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String // ios | android | web
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A single, order-independent connection between two users.
// userOneId is always the lexicographically-smaller id (enforced in service)
// so (userOneId,userTwoId,connectionType) is a stable unique key.
model Connection {
  id             String           @id @default(uuid())
  userOneId      String
  userTwoId      String
  connectionType ConnectionType
  status         ConnectionStatus @default(PENDING)
  requestedById  String // who initiated (for accept/decline UX)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userOne User @relation("ConnectionUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("ConnectionUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId, connectionType])
  @@index([userOneId, status])
  @@index([userTwoId, status])
  @@index([status])
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DIRECT)
  title     String? // group only
  // For DIRECT conversations, a deterministic key of the two member ids so we
  // never create duplicates. Null for groups.
  directKey String?          @unique
  // Dating-match anonymity: null = normal chat. 1 = anonymous (show pseudonym),
  // 2 = identities revealed, 3 = friends. Only set on dating-originated chats.
  anonymousTrust Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
}

model ConversationMember {
  id             String     @id @default(uuid())
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  lastReadAt     DateTime? // for unread counts
  muted          Boolean    @default(false)
  archived       Boolean    @default(false)
  pinned         Boolean    @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id               String      @id @default(uuid())
  conversationId   String
  senderId         String
  text             String?
  messageType      MessageType @default(TEXT)
  replyToMessageId String?
  shareJson        String? // a shared hub item (flight/product/property/…) rendered as a rich card
  edited           Boolean     @default(false)
  deleted          Boolean     @default(false) // "delete for everyone"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      Message?        @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies      Message[]       @relation("MessageReply")
  attachments  Attachment[]
  statuses     MessageStatus[]

  @@index([conversationId, createdAt]) // cursor pagination + ordering
  @@index([senderId])
  @@index([createdAt])
}

model MessageStatus {
  id        String         @id @default(uuid())
  messageId String
  userId    String // the recipient this status is for
  status    DeliveryStatus @default(SENT)
  readAt    DateTime?
  updatedAt DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, status])
  @@index([messageId])
}

model Attachment {
  id        String  @id @default(uuid())
  messageId String
  url       String
  thumbnail String?
  size      Int
  mimeType  String
  duration  Int? // seconds (voice/video)
  width     Int?
  height    Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ─────────────────────────── Nutrition Hub ───────────────────────────
// Diet + slot are stored as lowercase strings to match the frontend contract
// (Recipe.diet: 'veg'|'nonveg'|'pesc'|'egg'|'vegan'|'jain'|'everything', Slot: b|l|s|d).

model FoodPref {
  id        String   @id @default(uuid())
  userId    String   @unique
  diet      String   @default("everything")
  goal      String   @default("maintain") // lose | maintain | gain
  heightCm  Int?
  weightKg  Int?
  age       Int?
  sex       String? // male | female
  activity  Float    @default(1.4)
  extras    String? // JSON: cuisines, protein sources, meats, allergies, excluded foods, nutrition pattern, max cook time, conditions, budget, delivery, weekly plan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id              String @id @default(uuid())
  recipeNo        Int? // stable public recipe number (1..N) for the world library
  name            String
  country         String
  slot            String // b | l | s | d
  kcal            Int
  protein         Int
  carbs           Int
  fat             Int
  fiber           Int
  minutes         Int
  gramsPerServing Int
  diet            String
  servings        Int     @default(0) // 0 = batch totals (estimate servings); >0 = per-serving data (v2 dataset)
  healthGrade     String? // A–E health grade (v2 dataset)
  healthPercent   Int     @default(0) // 0–100 health score (v2 dataset)
  steps           String? // cached JSON array of cooking-method steps
  cookSteps       String? // cached JSON of structured cook steps [{text,durationSec,active}]

  ingredients RecipeIngredient[]
  meals       Meal[]

  @@index([slot])
  @@index([diet])
  @@index([recipeNo])
}

// A single logged food/drink item in the My Health Profile calorie tracker.
// Persisted per user per local day so the week strip builds over time.
model CalorieEntry {
  id        String   @id @default(uuid())
  userId    String
  date      String // YYYY-MM-DD (the user's local day)
  name      String
  kcal      Int
  type      String // Meal Plan | Extra | Alcohol
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  grams    Int
  priceInr Int    @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model MealPlan {
  id        String    @id @default(uuid())
  key       String    @unique
  userId    String
  mode      String    @default("individual") // individual | family
  weekStart DateTime? // Monday of the calendar week this plan is FOR (null = legacy → derive from createdAt)
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days MealPlanDay[]

  @@index([userId, mode])
  @@index([userId, mode, weekStart])
}

model MealPlanDay {
  id       String @id @default(uuid())
  planId   String
  dayIndex Int // 0..6
  dayName  String

  plan  MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@unique([planId, dayIndex])
  @@index([planId])
}

model Meal {
  id         String  @id @default(uuid())
  dayId      String
  slot       String // b | l | s | d
  recipeId   String
  skipped    Boolean @default(false)
  sidesRice  Int     @default(0)
  sidesRoti  Int     @default(0)
  sidesCurd  Int     @default(0)
  sidesSalad Int     @default(0)

  day    MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipe Recipe      @relation(fields: [recipeId], references: [id])

  @@index([dayId])
  @@index([recipeId])
}

/// Permanent, versioned snapshot of a generated weekly meal plan — nutrition
/// history (spec §19). One immutable row per generation; NEVER overwritten, so a
/// user's nutrition journey can be tracked over months/years. JSON stored as
/// String (same convention as BloodAnalysis.payload / FoodPref.extras).
model NutritionHistory {
  id         String   @id @default(uuid())
  userId     String
  mode       String   @default("individual") // individual | family
  planKey    String // the live plan this snapshot was taken from
  weekNumber Int // 1..N for this user+mode
  weekLabel  String // e.g. "Week of 2026-07-20"
  startDate  DateTime
  endDate    DateTime
  targets    String // JSON: personalised nutrition targets used
  context    String // JSON: blood version, medical conditions, cuisine mix, weekly schedule, diet/goal, profile version
  days       String // JSON: per-day meals (per-meal macros/cost/time) + daily totals + coverage
  weekly     String // JSON: weekly totals, variety scores, cuisine/protein distribution
  cost       Int      @default(0) // estimated weekly food cost (₹)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, mode, createdAt])
}

/// Admin-managed family member sub-profile (Family Meal Planner §). The account
/// holder creates one per person (no separate login); each carries their own
/// biometrics, diet, goal and medical conditions so the family plan can compute
/// per-member targets and portions. JSON extras (proteins/cuisines/allergies/
/// healthConditions) stored as String, mirroring FoodPref.extras.
model FamilyMember {
  id           String   @id @default(uuid())
  ownerId      String // the User who manages this member (household owner)
  memberUserId String? // set when this row mirrors a real invited Together City user (Household Connection)
  name         String
  role         String   @default("member") // household role: owner | adult | child | guest (legacy: father|mother|child|self|member)
  sex          String   @default("male")
  age          Int      @default(30)
  heightCm     Int      @default(170)
  weightKg     Float    @default(65)
  activity     Float    @default(1.4)
  goal         String   @default("maintain") // lose | maintain | gain
  diet         String   @default("everything")
  extras       String? // JSON: proteins[], cuisines[], allergies, healthConditions[]
  isSelf       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@index([memberUserId])
}

// One shared pantry per household (owned by ownerId). Updated when groceries are
// ordered (stocked) or meals are cooked (drawn down). Private to Nutrition Hub.
model PantryItem {
  id        String   @id @default(uuid())
  ownerId   String // household owner (User.id)
  name      String // canonical shopping item, e.g. "Tomatoes"
  aisle     String   @default("pantry") // supermarket aisle key
  grams     Int      @default(0) // on-hand quantity in grams / ml
  unit      String   @default("g") // display unit class: g | kg | ml | l | pc | bunch
  qtyLabel  String   @default("") // human-readable amount, e.g. "1.8 kg"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// A Household Connection between two real Together City users — PRIVATE to the
// Nutrition Hub. This is DELIBERATELY separate from the social `Connection`
// model: accepting a household invite never creates a friend/follow/social tie,
// and a social connection never creates a household one. The owner (ownerId) is
// the account whose family plan/grocery/dashboard the member joins.
model HouseholdMember {
  id            String   @id @default(uuid())
  ownerId       String // household owner (User.id)
  memberUserId  String // invited citizen (User.id)
  role          String   @default("adult") // owner | adult | child | guest
  status        String   @default("pending") // pending | accepted | declined | removed
  requestedById String // who sent the invite (always the owner)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, memberUserId])
  @@index([ownerId, status])
  @@index([memberUserId, status])
}

model GroceryCart {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id       String @id @default(uuid())
  cartId   String
  name     String
  category String // shelf-life bucket: pantry | weekly | daily  (spec: Smart Grocery Planner)
  qty      Int    @default(1) // legacy numeric qty (pieces or coarse units) — display uses qtyLabel
  grams    Int    @default(0) // exact total grams/ml derived from the meal plan
  unit     String @default("") // display unit class: g | kg | ml | l | pc | bunch
  qtyLabel String @default("") // human-readable amount, e.g. "1.8 kg", "18", "2 bunches"
  priceInr Int    @default(0)

  cart GroceryCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model WalletLedger {
  id        String   @id @default(uuid())
  userId    String
  amountInr Int
  kind      String // credit | debit | refund
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Social Hub ───────────────────────────

model Post {
  id        String   @id @default(uuid())
  authorId  String
  text      String?
  feeling   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  comments Comment[]
  likes    Like[]

  @@index([createdAt])
  @@index([authorId])
}

model PostMedia {
  id       String  @id @default(uuid())
  postId   String
  url      String
  kind     String // image | video
  thumbUrl String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// ─────────────────────────── Dating Hub ───────────────────────────
// Astrology-first: birth details feed the compatibility engine. Matches are
// order-independent pair rows (userOneId = smaller id), like Connection.

// Precomputed pair compatibility — refreshed whenever matches are generated.
model CompatibilityScore {
  id               String   @id @default(uuid())
  userA            String
  userB            String
  astrology        Int
  personality      Int
  relationshipGoal Int
  values           Int
  lifestyle        Int
  interest         Int
  distance         Int
  overall          Int
  lastCalculated   DateTime @updatedAt

  @@unique([userA, userB])
  @@index([userA, overall])
}

// Activity Dating — a host posts a plan; the AI invites the most compatible
// people; invitees connect or pass; mutual connect opens an anonymous chat that
// can progress through trust levels.
model DatingActivity {
  id          String   @id @default(uuid())
  hostId      String
  text        String // "Watch the new Superman movie."
  category    String // restaurant | theatre | cafe | park | city | any
  date        String // YYYY-MM-DD
  time        String? // HH:MM
  groupSize   String   @default("1") // 1 | 2-4 | group
  description String?
  createdAt   DateTime @default(now())

  @@index([hostId])
}

model ActivityInvite {
  id             String   @id @default(uuid())
  activityId     String
  invitedUserId  String
  compatibility  Int
  status         String   @default("pending") // pending | connected | passed
  trustLevel     Int      @default(1) // 1 anonymous · 2 revealed · 3 friends
  invitedReveal  Boolean  @default(false)
  hostReveal     Boolean  @default(false)
  invitedFriends Boolean  @default(false)
  hostFriends    Boolean  @default(false)
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([invitedUserId, status])
  @@index([activityId])
}

model DatingProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  gender     String // male | female | nonbinary
  seeking    String // male | female | nonbinary | any
  bio        String?
  birthDate  DateTime
  birthTime  String?
  birthPlace String?
  interests  String   @default("") // csv
  extras     String? // JSON: extended profile (lifestyle, personality, match prefs, photos…)
  moderation String   @default("approved") // approved | pending | rejected | review
  moderationJson String? // JSON: { decision, confidence, checks[], reasons[] }
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DatingMatch {
  id             String   @id @default(uuid())
  userOneId      String
  userTwoId      String
  kind           String   @default("romantic") // romantic | platonic
  status         String   @default("pending") // pending | matched | passed
  likedByOne     Boolean  @default(false)
  likedByTwo     Boolean  @default(false)
  passedByOne    Boolean  @default(false)
  passedByTwo    Boolean  @default(false)
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userOne User @relation("DatingUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("DatingUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId, kind])
  @@index([userOneId, status])
  @@index([userTwoId, status])
}

// ─────────────── Nutrition Hub: orders, deliveries & wallet ───────────────

model NutritionOrder {
  id        String   @id @default(uuid())
  userId    String
  totalInr  Int
  status    String   @default("placed") // placed | cancelled
  createdAt DateTime @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      NutritionOrderItem[]
  deliveries FreshDelivery[]

  @@index([userId, createdAt])
}

model NutritionOrderItem {
  id       String @id @default(uuid())
  orderId  String
  name     String
  category String // fresh | pantry
  qty      Int    @default(1)
  priceInr Int    @default(0)

  order NutritionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model FreshDelivery {
  id        String   @id @default(uuid())
  orderId   String
  dayIndex  Int // 0..6 within the order week
  date      DateTime
  status    String   @default("scheduled") // scheduled | delivered | cancelled
  amountInr Int      @default(0)

  order NutritionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────── Nutrition Hub: blood panel & expert care ───────────────

model BloodMarker {
  id        String   @id @default(uuid())
  userId    String
  key       String // hb | vitd | b12 | ferritin | hba1c | ldl
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Dietitian {
  id        String @id @default(uuid())
  userId    String @unique // dietitians are Users, so booking opens a real chat
  specialty String
  languages String // csv
  rating    Float  @default(4.8)
  priceInr  Int

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings DietitianBooking[]
}

model DietitianBooking {
  id             String   @id @default(uuid())
  userId         String
  dietitianId    String
  conversationId String?
  createdAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietitian Dietitian @relation(fields: [dietitianId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Medical Hub ───────────────────────────
// Source of truth for health data. Dated blood-test panels give history/trends;
// other hubs (Nutrition, Beauty, Fitness) read biomarkers by reference with consent.

model MedicalBloodTest {
  id        String   @id @default(uuid())
  userId    String
  takenOn   DateTime @default(now())
  lab       String?
  aiSummary String? // legacy inline cache (superseded by BloodAnalysis); kept to avoid a destructive drop
  createdAt DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  biomarkers MedicalBiomarker[]
  analyses   BloodAnalysis[]

  @@index([userId, takenOn])
}

/**
 * The single, stored result of analysing one blood test at one analysis version.
 * The AI runs ONCE when a test is uploaded/changed (or the version bumps); every
 * consumer (Medical Hub, Nutrition, dashboard, meal planner) reads this record
 * instead of re-calling the AI. `reportHash` lets an identical re-upload reuse an
 * existing analysis. Old versions are kept so improvements don't lose history.
 */
model BloodAnalysis {
  id              String   @id @default(uuid())
  bloodTestId     String
  userId          String
  analysisVersion String // e.g. "v1" — bump when the prompt/model changes
  model           String // model id that produced the narrative
  reportHash      String // SHA-256 of the biomarker values (dedup identical reports)
  healthScore     Int
  band            String
  payload         String // full analysis JSON (markers, conditions, narrative, restrictions, supplements)
  analyzedAt      DateTime @default(now())

  bloodTest MedicalBloodTest @relation(fields: [bloodTestId], references: [id], onDelete: Cascade)

  @@unique([bloodTestId, analysisVersion])
  @@index([userId, analyzedAt])
  @@index([reportHash, analysisVersion])
}

model MedicalBiomarker {
  id          String @id @default(uuid())
  bloodTestId String
  key         String // hb | ferritin | vitd | b12 | folate | hba1c | ldl | trig | crp | ...
  value       Float

  bloodTest MedicalBloodTest @relation(fields: [bloodTestId], references: [id], onDelete: Cascade)

  @@index([bloodTestId])
}

// ─────────────── Medical Hub: records, consults & consent ───────────────

model MedicalRecord {
  id         String   @id @default(uuid())
  userId     String
  kind       String // prescription | report | condition | allergy | vaccination | note
  title      String
  detail     String?
  fileUrl    String? // public URL of the uploaded document (R2)
  fileKey    String? // R2 object key (for deletion)
  mimeType   String? // application/pdf | image/jpeg | image/png
  sizeBytes  Int      @default(0) // counts against the citizen's shared 10 GB vault
  bloodTestId String? // if this document produced a parsed blood panel, link it
  recordedOn DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedOn])
}

model Doctor {
  id        String @id @default(uuid())
  userId    String @unique // doctors are Users — booking opens a real chat
  specialty String
  hospital  String?
  languages String // csv
  rating    Float  @default(4.8)
  priceInr  Int

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consults Consult[]
}

model Consult {
  id             String    @id @default(uuid())
  userId         String
  doctorId       String
  reason         String?
  scheduledAt    DateTime?
  conversationId String?
  status         String    @default("booked") // booked | completed | cancelled
  createdAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Consent core: which hubs may read the user's Medical biomarkers.
model MedicalConsent {
  id        String   @id @default(uuid())
  userId    String
  hub       String // nutrition | beauty | fitness
  granted   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hub])
  @@index([userId])
}

// ─────────────────────────── Beauty Hub ───────────────────────────
// Beauty personalises skin/hair from the user's stated profile and — with
// consent — from the biomarkers the Medical Hub owns (see MedicalConsent).
model BeautyProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  skinType     String   @default("normal") // dry | oily | combination | normal | sensitive
  hairType     String   @default("straight") // straight | wavy | curly | coily
  concerns     String   @default("") // csv of concern keys (legacy quick concerns)
  extras       String? // JSON: full skin & hair profile (goals, tone, routine, allergies, conditions, budget…)
  photosJson   String   @default("[]") // JSON [{slot, analyzedAt, findings[]}] — latest photo assessment
  progressJson String   @default("[]") // JSON [{id, date, findings[], score, thumb}] — weekly progress timeline
  analysisJson String? // JSON: saved one-time assessment (skin + hair attribute readings, issues, recommendations)
  analysisLogJson String? // JSON [iso timestamps] — every photo analysis run (rate-limits re-uploads; survives deletes)
  analyzedAt   DateTime? // when the saved assessment was generated (no re-analysis until re-saved)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BeautyOrder {
  id        String   @id @default(uuid())
  userId    String
  itemsJson String // JSON array of {id,name,priceInr,qty}
  totalInr  Int
  status    String   @default("placed") // placed | cancelled
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────── Fitness Hub ───────────────────────────
// Age- and condition-differentiated training. Reads biomarkers (iron, glucose,
// inflammation) from the Medical Hub via consent, like Beauty.
model FitnessProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  age        Int      @default(35)
  sex        String   @default("other") // female | male | other
  level      String   @default("beginner") // basic | beginner | intermediate | advanced | athlete
  mode       String   @default("mixed") // mixed | strength | walking | running
  goal       String   @default("general") // general | weightLoss | strength | endurance
  conditions String   @default("") // csv: hypertension|diabetes|pregnancy|jointPain
  heightCm   Int?
  weightKg   Int?
  bodyGoal   String   @default("athletic") // buildMuscle | leanDefine | athletic | fatLoss
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id        String   @id @default(uuid())
  userId    String
  focus     String
  minutes   Int
  intensity String   @default("moderate") // light | moderate | vigorous
  note      String?
  doneAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt])
}

// ─────────────────────────── Financial Hub ───────────────────────────
// The unifying city wallet: aggregates spend from every commerce hub
// (Nutrition orders, Beauty orders, Medical consults) into one view.
model CityWallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  balanceInr Int      @default(0)
  cardBrand  String?
  cardLast4  String?
  cardName   String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTxn {
  id        String   @id @default(uuid())
  userId    String
  kind      String // topup | payment | refund
  amountInr Int
  hub       String? // Nutrition | Beauty | Medical | Wallet (for payments)
  category  String? // nutrition | beauty | medical
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Budget {
  id         String @id @default(uuid())
  userId     String
  category   String // nutrition | beauty | medical
  monthlyInr Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// ─────────────────────────── Jobs Hub ───────────────────────────
// Two-sided: candidates upload a resume → parsed profile → matched roles;
// companies post jobs and see applicants. "Upload once. We do the rest."
model JobProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  headline        String   @default("")
  skills          String   @default("") // csv of skill keys
  experienceYears Int      @default(0)
  seniority       String   @default("junior") // junior | mid | senior | lead
  location        String?
  resumeText      String   @default("")
  resumeName      String?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id         String   @id @default(uuid())
  postedById String? // null = seeded platform listing
  title      String
  company    String
  location   String
  remote     Boolean  @default(false)
  seniority  String   @default("mid")
  skills     String   @default("") // csv of skill keys
  minYears   Int      @default(0)
  salaryLpa  Int      @default(0)
  blurb      String   @default("")
  createdAt  DateTime @default(now())

  postedBy     User?            @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([postedById])
}

model JobApplication {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  title     String
  company   String
  coverNote String?
  status    String   @default("applied") // applied | shortlisted | rejected
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
}

// ─────────────────────────── Real Estate Hub ───────────────────────────
// Photos are mandatory to post (enforced in the DTO + service). Under-construction
// listings carry RERA, possession, progress %, floor plans and payment milestones.
// Audit trail for every moderation decision (automated + manual).
model ModerationLog {
  id        String   @id @default(uuid())
  listingId String
  actor     String // "system" or a moderator handle
  decision  String // approved | rejected | review | removed
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([createdAt])
}

model Property {
  id           String   @id @default(uuid())
  sellerId     String? // null = seeded platform listing
  listingType  String // sale | rent
  propertyType String // apartment | villa | plot | commercial
  status       String   @default("ready") // ready | under_construction
  moderation   String   @default("approved") // approved | pending | rejected | review
  moderationJson String? // JSON: { decision, confidence, score, checks[], reasons[], decidedAt }
  title        String
  city         String
  locality     String
  priceInr     Int
  areaSqft     Int
  bedrooms     Int      @default(0)
  bathrooms    Int      @default(0)
  furnishing   String?
  floor        Int?
  totalFloors  Int?
  facing       String?
  amenities    String   @default("") // csv
  description  String?
  photosJson   String   @default("[]") // JSON [{url,caption?}] — never empty for a live listing

  // under-construction
  projectName    String?
  developer      String?
  reraId         String?
  possessionDate String?
  progressPct    Int?
  floorPlansJson String? // JSON [{label,url}]
  milestonesJson String? // JSON [{label,pct,note?}]

  createdAt DateTime @default(now())

  seller User? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, city])
  @@index([sellerId])
}

// ─────────────────────────── Entertainment Hub ───────────────────────────
// Discover events; book tickets that pay through the one city wallet (Financial).
model Event {
  id           String @id @default(uuid())
  title        String
  category     String // movies | concerts | comedy | theatre | sports | experiences
  venue        String
  city         String
  date         String // YYYY-MM-DD
  time         String
  description  String
  posterUrl    String
  priceFromInr Int
  tiersJson    String // JSON [{name,priceInr,available}]

  bookings TicketBooking[]

  @@index([category, city])
}

model TicketBooking {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  title     String
  category  String
  tier      String
  qty       Int
  totalInr  Int
  code      String
  status    String   @default("confirmed")
  eventDate String
  eventTime String
  venue     String
  city      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────── Travel Hub ───────────────────────────
// Curated packages + a Skyscanner-style flight metasearch (synthesised, no API).
// Bookings (package or flight) pay through the one city wallet (Financial).
model TravelPackage {
  id             String @id @default(uuid())
  title          String
  destination    String
  country        String
  category       String // beach | mountains | heritage | international | weekend | wildlife
  nights         Int
  days           Int
  priceFromInr   Int
  summary        String
  heroUrl        String
  highlightsJson String @default("[]")
  inclusionsJson String @default("[]")
  itineraryJson  String @default("[]")
  tiersJson      String @default("[]")

  @@index([category])
}

model TripBooking {
  id         String   @id @default(uuid())
  userId     String
  kind       String // package | flight
  title      String
  subtitle   String
  category   String
  tier       String
  pax        Int
  totalInr   Int
  code       String
  status     String   @default("confirmed")
  detailJson String   @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Restaurant {
  id             String  @id @default(uuid())
  name           String
  cuisine        String // north-indian | south-indian | italian | chinese | japanese | cafe | biryani | street
  area           String
  city           String
  rating         Float
  priceForTwoInr Int
  tagline        String
  openHours      String
  vegFriendly    Boolean @default(true)
  heroUrl        String
  menuJson       String  @default("[]")

  @@index([cuisine])
}

model DiningOrder {
  id             String   @id @default(uuid())
  userId         String
  restaurantId   String
  restaurantName String
  area           String
  mode           String // delivery | dinein
  itemsJson      String   @default("[]")
  subtotalInr    Int
  packingInr     Int      @default(0)
  taxInr         Int      @default(0)
  totalInr       Int
  code           String
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reservation {
  id             String   @id @default(uuid())
  userId         String
  restaurantId   String
  restaurantName String
  area           String
  date           String
  time           String
  partySize      Int
  guestName      String
  notes          String   @default("")
  code           String
  status         String   @default("confirmed")
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MailAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String   @unique
  quotaBytes BigInt  @default(10737418240) // 10 GB
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MailMessage {
  id         String   @id @default(uuid())
  ownerId    String // whose mailbox this copy lives in
  boxUserId  String // duplicate of ownerId for indexing clarity
  folder     String // inbox | sent | trash
  fromAddr   String
  fromName   String
  toAddr     String
  toName     String
  subject    String
  body       String
  snippet    String   @default("")
  sizeBytes  Int      @default(0)
  read       Boolean  @default(false)
  starred    Boolean  @default(false)
  system     Boolean  @default(false)
  threadId   String?
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, folder, createdAt])
}

// Outbound delivery log — every message dispatched OUTSIDE the city (email or SMS)
// through the pluggable messaging provider. This is the receipt/notification ledger.
model EmailDelivery {
  id                String   @id @default(uuid())
  userId            String
  channel           String   @default("email") // email | sms
  toEmail           String? // set for channel=email
  toPhone           String? // set for channel=sms
  kind              String // receipt | recovery | security | welcome
  subject           String
  body              String
  provider          String   @default("stub") // stub | sendgrid | ses | smtp | twilio | ...
  providerMessageId String? // id returned by the provider (audit trail)
  status            String   @default("sent") // queued | sent | failed
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email-verification (and future purpose-scoped) tokens. The raw token is sent
// in the link; only its sha256 is stored so it's lookup-able but not reversible.
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256(rawToken)
  purpose   String    @default("email_verification")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Account-recovery OTP (production forgot-password flow). The OTP is stored
// HASHED (argon2), carried by an opaque recoveryToken (never the identifier),
// with attempt/resend limits, a lockout window, and IP/device for the audit log.
model RecoveryCode {
  id          String    @id @default(uuid())
  userId      String
  otpHash     String // argon2 hash of the 6-digit code — never the code itself
  token       String    @unique // opaque handle returned to the client (request stage)
  resetToken  String?   @unique // issued after successful OTP verification (reset stage)
  purpose     String    @default("password_recovery")
  channel     String    @default("email") // email | sms
  expiresAt   DateTime
  attempts    Int       @default(0)
  resends     Int       @default(0)
  lockedUntil DateTime?
  verifiedAt  DateTime?
  usedAt      DateTime?
  ipAddress   String?
  device      String? // user-agent fingerprint
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────── Platform master data (reusable lookups) ───────────────────────
// One generic table powering every standardized dropdown across Together City
// (countries, states, cities, languages, religions, …). New dropdown types need
// no schema change — just a new `category`. Hierarchy (country→state→city) is
// expressed via `parentCode` referencing the parent row's `code` in its category.
model Lookup {
  id         String  @id @default(uuid())
  category   String // 'country' | 'state' | 'city' | 'language' | 'religion' | …
  code       String // stable code, unique within its category
  label      String // human display value
  parentCode String? // parent row's code (e.g. a city's state, a state's country)
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@unique([category, code])
  @@index([category, parentCode])
  @@index([category, label])
}
