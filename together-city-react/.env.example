# Together City React — environment
# NestJS backend base URL (REST)
VITE_API_URL=http://localhost:3000
# Socket.IO gateway URL (usually same host as the API)
VITE_SOCKET_URL=http://localhost:3000

# Cloudflare Turnstile (bot protection on sign-up and sign-in). Unset = off.
VITE_TURNSTILE_SITE_KEY=
