# Together City React — environment
# NestJS backend base URL (REST)
VITE_API_URL=http://localhost:3000
# Socket.IO gateway URL (usually same host as the API)
VITE_SOCKET_URL=http://localhost:3000

# Cloudflare Turnstile (bot protection on sign-up and sign-in). Unset = off.
# Public key — it ships in the HTML, so it belongs in git, not in a secret
# store. Use the DEV widget's key here (the one whose domains include
# localhost); .env.production carries the production widget's. The server
# refuses a token minted on a hostname its own TURNSTILE_HOSTNAMES does not
# list, so the two keys are not interchangeable.
VITE_TURNSTILE_SITE_KEY=
