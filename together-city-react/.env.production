# Production frontend config — the live backend on our custom domain.
# These are baked into the Vite build; override in the Vercel dashboard if the URL ever changes.
VITE_API_URL=https://api.togethercity.app/api
VITE_SOCKET_URL=https://api.togethercity.app
# Cloudflare Turnstile SITE key (public). Set it here or in the Vercel dashboard the
# same day TURNSTILE_SECRET + TURNSTILE_HOSTNAMES go onto Railway: the server 403s
# every register/login/forgot without a token once the secret is set, and the
# client sends no token without this key. Both on, or both off — never one (5 Sep).
# VITE_TURNSTILE_SITE_KEY=
